{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.3.6",
  "description": "__MSG_appDesc__",
  "default_locale": "th",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; object-src 'self'"
  },
  "sandbox": {
    "pages": [
      "video-composer-sandbox.html"
    ]
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "alarms",
    "unlimitedStorage",
    "cookies",
    "offscreen",
    "browsingData",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://*.shopee.co.th/*",
    "https://*.susercontent.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.scf.usercontent.goog/*",
    "https://*.usercontent.goog/*",
    "https://*.google.com/*",
    "https://*.supabase.co/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://meta.ai/*",
    "*://www.meta.ai/*",
    "https://*.fbcdn.net/*"
  ],
  "action": {
    "default_title": "PUP PAP AI - เธเธธเนเธเธเธฑเนเธ AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meta.ai/*",
        "*://www.meta.ai/*"
      ],
      "js": [
        "scripts/meta-automator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio/upload*"
      ],
      "js": [
        "scripts/tiktok-poster.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://shop.tiktok.com/*"
      ],
      "js": [
        "scripts/showcase-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "scripts/flowMediaInterceptor.js",
        "scripts/flowSite.js",
        "scripts/flowImageMode.js",
        "scripts/flowModernVideo.js",
        "scripts/flowModernReference.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*",
        "https://*.scf.usercontent.goog/*"
      ],
      "js": [
        "scripts/flow-automator.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.scf.usercontent.goog/*"
      ],
      "js": [
        "scripts/flow-video-interceptor.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/tiktok-scanner.js"
      ],
      "matches": [
        "https://www.tiktok.com/*"
      ]
    },
    {
      "resources": [
        "assets/videoComposerSandbox.js",
        "assets/vendor/ffmpeg/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
