  /* ═══════════════════════════════════════════════════════════════════════
     MEDIA VAULT
     ═══════════════════════════════════════════════════════════════════════ */
  let vaultFilter = 'all';
  let selectedVaultIds = new Set();
  let currentVaultList = [];

  async function refreshVault() {
    // อ่านเฉพาะ metadata จาก chrome.storage.local (ไม่โหลด video base64 ทั้งหมด → เร็วกว่า 100x)
    const storeData = await chrome.storage.local.get(['phimbot_media_vault', 'phimbot_products']);
    const vault = storeData.phimbot_media_vault || [];
    const catalogProds = Array.isArray(storeData.phimbot_products) ? storeData.phimbot_products : [];

    // ═══ Auto-Migrate Inline Videos & Missing ProductIds (Self-Healing Vault) ═══
    let vaultMutated = false;
    const extraStorageWrites = {};
    for (const item of vault) {
      // 1. ย้าย videoBase64 ที่ฝังอยู่ใน array ออกไปเก็บใน videoStorageKey แยกต่างหาก (ลดขนาด vault จาก 120MB เหลือ ~5MB)
      if (item.videoBase64 && item.videoBase64.length > 50000) {
        const vKey = item.videoStorageKey && item.videoStorageKey !== 'storage_failed'
          ? item.videoStorageKey
          : `phimbot_video_${item.id}`;
        extraStorageWrites[vKey] = item.videoBase64;
        item.videoStorageKey = vKey;
        item.videoBase64Size = item.videoBase64.length;
        item.videoBase64 = '';
        vaultMutated = true;
      }
      // 2. ซ่อมรหัสสินค้า (productId) ที่ว่างหรือติด PID_UNKNOWN โดยจับคู่ชื่อสินค้าจากคลังสินค้าอัตโนมัติ
      const cleaned = cleanProductId(item.productId);
      if (cleaned !== (item.productId || '')) {
        item.productId = cleaned;
        vaultMutated = true;
      }
      if (!item.productId && item.productName && catalogProds.length > 0) {
        const matched = catalogProds.find(p => {
          const pName = String(p.name || p.title || '').trim();
          return pName && (pName === item.productName.trim() || pName.includes(item.productName.trim()) || item.productName.trim().includes(pName));
        });
        if (matched) {
          const mPid = cleanProductId(matched.productId || matched.tiktokProductId || matched.id);
          if (mPid) {
            item.productId = mPid;
            vaultMutated = true;
          }
        }
      }
    }
    if (vaultMutated) {
      try {
        for (const [vKey, vData] of Object.entries(extraStorageWrites)) {
          try {
            await chrome.storage.local.set({ [vKey]: vData });
          } catch (singleErr) {
            console.warn('[Vault] Failed to extract single video key:', vKey, singleErr);
          }
        }
        await chrome.storage.local.set({ phimbot_media_vault: vault });
        console.log('[Vault] Self-healed vault items (extracted inline videos & linked missing productIds)');
      } catch (e) {
        console.warn('[Vault] Self-heal save warning:', e);
      }
    }

    currentVaultList = vault;

    renderVault(vault);

    // ═══ Backfill thumbnails สำหรับคลิปเก่าที่ไม่มี thumbnail ═══
    const needThumb = vault.filter(v => !v.thumbnail && v.videoStorageKey && v.videoStorageKey !== 'storage_failed');
    if (needThumb.length > 0) {
      backfillThumbnails(needThumb, vault);
    }
  }

  /** โหลด video base64 ของ item เดียว (on-demand) */
  async function loadVideoBase64(item) {
    if (item.videoBase64) return item.videoBase64;
    if (!item.videoStorageKey || item.videoStorageKey === 'storage_failed') return '';
    const data = await chrome.storage.local.get([item.videoStorageKey]);
    const b64 = data[item.videoStorageKey] || '';
    item.videoBase64 = b64;
    return b64;
  }

  /** สร้าง thumbnail ย้อนหลังสำหรับคลิปเก่า (background, ไม่บล็อก UI) */
  async function backfillThumbnails(items, vault) {
    let updated = 0;
    for (const item of items) {
      try {
        const b64 = await loadVideoBase64(item);
        if (!b64) continue;
        const thumb = await generateThumbnailFromBase64(b64);
        if (!thumb) continue;
        item.thumbnail = thumb;
        item.videoBase64 = ''; // ปล่อย RAM
        updated++;
        // Update DOM ทันที
        const imgEl = document.querySelector(`[data-thumb-id="${item.id}"]`);
        if (imgEl) { imgEl.src = thumb; imgEl.style.display = 'block'; }
        const emojiEl = document.querySelector(`[data-emoji-id="${item.id}"]`);
        if (emojiEl) emojiEl.style.display = 'none';
      } catch (_) {}
    }
    if (updated > 0) {
      // Save thumbnail กลับเข้า vault metadata
      const store = await chrome.storage.local.get(['phimbot_media_vault']);
      const vaultNow = store.phimbot_media_vault || [];
      for (const item of items) {
        if (!item.thumbnail) continue;
        const found = vaultNow.find(v => v.id === item.id);
        if (found) found.thumbnail = item.thumbnail;
      }
      await chrome.storage.local.set({ phimbot_media_vault: vaultNow });
      console.log(`[Vault] Backfilled ${updated} thumbnails`);
    }
  }

  /** สร้าง thumbnail จาก video base64 dataURL */
  function generateThumbnailFromBase64(videoBase64) {
    return new Promise((resolve) => {
      const v = document.createElement('video');
      v.muted = true;
      v.preload = 'auto';
      const timeoutId = setTimeout(() => { v.remove(); resolve(''); }, 10000);
      v.addEventListener('loadeddata', () => {
        v.currentTime = Math.min(0.5, v.duration * 0.1 || 0.5);
      }, { once: true });
      v.addEventListener('seeked', () => {
        clearTimeout(timeoutId);
        try {
          const canvas = document.createElement('canvas');
          const scale = 120 / Math.max(v.videoWidth, v.videoHeight, 1);
          canvas.width = Math.round(v.videoWidth * scale);
          canvas.height = Math.round(v.videoHeight * scale);
          canvas.getContext('2d').drawImage(v, 0, 0, canvas.width, canvas.height);
          resolve(canvas.toDataURL('image/jpeg', 0.6));
        } catch(_) { resolve(''); }
        v.remove();
      }, { once: true });
      v.addEventListener('error', () => { clearTimeout(timeoutId); v.remove(); resolve(''); }, { once: true });
      v.src = videoBase64;
    });
  }

