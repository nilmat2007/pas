  // ═══ Hashtag & Caption Helpers ═══
  function resolveProductHashtags(productOrItem) {
    let rawTags = [];

    // 1. Direct hashtags field on item
    if (productOrItem) {
      if (Array.isArray(productOrItem.hashtags) && productOrItem.hashtags.length > 0) {
        rawTags.push(...productOrItem.hashtags);
      } else if (typeof productOrItem.hashtags === 'string' && productOrItem.hashtags.trim()) {
        rawTags.push(...productOrItem.hashtags.replace(/,/g, ' ').split(/\s+/));
      }
    }

    // 2. Look up product in factoryProducts by ID or name
    if (rawTags.length === 0 && productOrItem && typeof factoryProducts !== 'undefined') {
      const pId = productOrItem.productId || productOrItem.id;
      const matched = factoryProducts.find(p => (p.productId || p.id) === pId || (productOrItem.productName && p.name === productOrItem.productName));
      if (matched) {
        if (Array.isArray(matched.hashtags) && matched.hashtags.length > 0) {
          rawTags.push(...matched.hashtags);
        } else if (typeof matched.hashtags === 'string' && matched.hashtags.trim()) {
          rawTags.push(...matched.hashtags.replace(/,/g, ' ').split(/\s+/));
        }
      }
    }

    // 3. Check UI hashtags input in sidepanel
    if (rawTags.length === 0) {
      const inputVal = document.getElementById('hashtagsInput')?.value;
      if (inputVal && inputVal.trim()) {
        rawTags.push(...inputVal.replace(/,/g, ' ').split(/\s+/));
      }
    }

    // 4. Extract from caption or headline
    if (rawTags.length === 0 && productOrItem) {
      const textSource = `${productOrItem.caption || ''} ${productOrItem.headline || ''}`;
      const matches = textSource.match(/#([a-zA-Z0-9ก-๙_]+)/g);
      if (matches) {
        rawTags.push(...matches);
      }
    }

    // 5. Default fallback tags
    if (rawTags.length === 0) {
      rawTags = ['TikTokShop', 'TikTokShopTH', 'ของดีบอกต่อ', 'รีวิว'];
    }

    // Clean, remove '#' prefix, deduplicate, limit to 5
    const cleaned = Array.from(new Set(
      rawTags
        .map(t => String(t || '').trim().replace(/^#+/, ''))
        .filter(Boolean)
    )).slice(0, 5);

    return cleaned.length > 0 ? cleaned : ['TikTokShop', 'TikTokShopTH', 'ของดีบอกต่อ', 'รีวิว'];
  }

  function cleanCaptionText(headline, productName, caption) {
    let text = '';
    if (caption && caption.trim()) {
      text = caption;
    } else {
      const h = (headline || '').trim();
      const p = (productName || '').trim();
      if (h && p) {
        text = h.toLowerCase().includes(p.toLowerCase()) ? h : `${h}\n${p}`;
      } else {
        text = h || p || 'รีวิวสินค้าของดีบอกต่อ';
      }
    }
    // Remove internal tags like [คลิป 1/2 - Hook A]
    text = text.replace(/\s*\[คลิป\s*\d+\/\d+[^\]]*\]/g, '').trim();
    return text;
  }

  function resolveProductImage(productOrItem) {
    if (!productOrItem) return '';
    if (productOrItem.productImage) return productOrItem.productImage;
    if (productOrItem.imageUrl) return productOrItem.imageUrl;
    if (productOrItem.image) return productOrItem.image;
    if (Array.isArray(productOrItem.images) && productOrItem.images.length > 0) {
      const first = productOrItem.images[0];
      return typeof first === 'string' ? first : (first?.url || '');
    }
    const pId = productOrItem.productId || productOrItem.id || productOrItem.offerId;
    const pName = productOrItem.productName || productOrItem.name || productOrItem.title;
    if (typeof factoryProducts !== 'undefined' && factoryProducts.length > 0) {
      const matched = factoryProducts.find(p => (pId && (p.productId === pId || p.id === pId)) || (pName && p.name === pName));
      if (matched) {
        if (matched.imageUrl) return matched.imageUrl;
        if (matched.image) return matched.image;
        if (Array.isArray(matched.images) && matched.images.length > 0) {
          const first = matched.images[0];
          return typeof first === 'string' ? first : (first?.url || '');
        }
      }
    }
    return '';
  }

  function generateVideoThumbnail(videoBase64OrDataUrl) {
    return new Promise((resolve) => {
      if (!videoBase64OrDataUrl || typeof videoBase64OrDataUrl !== 'string') return resolve('');
      const dataUrl = videoBase64OrDataUrl.startsWith('data:')
        ? videoBase64OrDataUrl
        : `data:video/mp4;base64,${videoBase64OrDataUrl}`;
      try {
        const v = document.createElement('video');
        v.muted = true;
        v.preload = 'auto';
        v.crossOrigin = 'anonymous';
        let done = false;
        const timer = setTimeout(() => {
          if (!done) { done = true; v.remove(); resolve(''); }
        }, 5000);

        v.addEventListener('loadeddata', () => {
          v.currentTime = 0.2;
        }, { once: true });

        v.addEventListener('seeked', () => {
          if (done) return;
          done = true;
          clearTimeout(timer);
          try {
            const canvas = document.createElement('canvas');
            const maxDim = 120;
            const w = v.videoWidth || 120;
            const h = v.videoHeight || 120;
            const scale = maxDim / Math.max(w, h, 1);
            canvas.width = Math.max(36, Math.round(w * scale));
            canvas.height = Math.max(36, Math.round(h * scale));
            const ctx = canvas.getContext('2d');
            ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
            const thumb = canvas.toDataURL('image/jpeg', 0.7);
            v.remove();
            resolve(thumb);
          } catch (_) {
            v.remove();
            resolve('');
          }
        }, { once: true });

        v.addEventListener('error', () => {
          if (!done) { done = true; clearTimeout(timer); v.remove(); resolve(''); }
        }, { once: true });

        v.src = dataUrl;
      } catch (_) {
        resolve('');
      }
    });
  }

  function cleanProductId(raw) {
    const s = String(raw || '').trim();
    if (!s || /^(PID_)?UNKNOWN$/i.test(s) || /^null$/i.test(s) || /^undefined$/i.test(s)) return '';
    return s.replace(/^PID_/i, '').trim();
  }

  async function resolveCatalogProduct(vidOrItem, fallbackIndex = 0) {
    const rawPid = cleanProductId(vidOrItem?.productId || vidOrItem?.tiktokProductId || vidOrItem?.id);
    const rawName = String(vidOrItem?.productName || vidOrItem?.name || vidOrItem?.title || '').trim();
    const list1 = (typeof factoryProducts !== 'undefined' && Array.isArray(factoryProducts)) ? factoryProducts : [];
    const store = await chrome.storage.local.get(['phimbot_products']).catch(() => ({}));
    const list2 = Array.isArray(store?.phimbot_products) ? store.phimbot_products : [];
    const allProds = [...list1, ...list2];

    let matched = null;
    if (rawPid) {
      matched = allProds.find(p => cleanProductId(p.productId || p.tiktokProductId || p.id) === rawPid);
    }
    if (!matched && rawName) {
      matched = allProds.find(p => {
        const pn = String(p.name || p.title || '').trim();
        return pn && (pn === rawName || pn.includes(rawName) || rawName.includes(pn));
      });
    }
    if (!matched && list1.length > 0) {
      matched = list1[fallbackIndex % list1.length] || list1[0];
    }
    if (!matched && list2.length > 0) {
      matched = list2[fallbackIndex % list2.length] || list2[0];
    }
    return {
      matched,
      productId: rawPid || cleanProductId(matched?.tiktokProductId || matched?.productId || matched?.id),
      productUrl: vidOrItem?.productUrl || matched?.affiliateUrl || matched?.productUrl || matched?.offerUrl || matched?.url || '',
      productName: rawName || matched?.name || matched?.title || 'สินค้า',
    };
  }

  // Post execution helper after production
  async function executeAutoPostTarget(targetArg, batchStartTime) {
    // อ่านค่าสดจาก dropdown เสมอ เพื่อให้ตรงกับที่ผู้ใช้เลือกไว้ใน UI
    const liveSelectVal = $('#factoryPostTargetSelect')?.value;
    const target = liveSelectVal || targetArg || factoryPostTarget || 'vault_only';
    factoryPostTarget = target;

    const TARGET_LABELS = {
      vault_only: '💾 เก็บในคลัง (ไม่โพสต์)',
      cloud_sync: '☁️ ส่งเข้ามือถืออัตโนมัติ (PUP PAP POST)',
      tiktok_now: '🎵 โพสต์ TikTok Shop ทันที (ติดตะกร้า)',
      shopee_now: '🛒 โพสต์ Shopee Video ทันที',
      reels_now: '🎬 โพสต์ Facebook Reels ทันที',
      queue_schedule: '⏳ เข้าคิว / ตั้งเวลาโพสต์รวม (ติดตะกร้า)',
      post_now: '🚀 โพสต์ทันทีตามแหล่งสินค้า'
    };
    addMonitorLog(`📤 [STEP 4] เป้าหมาย: ${TARGET_LABELS[target] || target}`, 'POST');

    // อัปเดต UI แท็บคลังวีดีโอทันทีเพื่อให้เห็นคลิปใหม่เสมอ
    try { await refreshVault(); } catch (_) {}

    // ═══ Guard: บังคับมี batchStartTime เพื่อป้องกันโพสต์คลิปเก่า ═══
    if (!batchStartTime) {
      addMonitorLog('⛔ ยกเลิกโพสต์: ไม่พบ batchStartTime — ป้องกันการโพสต์คลิปที่ไม่ได้อยู่ใน batch นี้', 'ERROR');
      showToast('⛔ ยกเลิกโพสต์: ไม่พบข้อมูล batch', 5000);
      return { tiktok: 0, shopee: 0, reels: 0, cloudSync: 0, total: 0, skipped: true };
    }

    // ═══ อ่าน vault ตรงจาก chrome.storage.local + merge video data ═══
    const storeData = await chrome.storage.local.get(['phimbot_media_vault']);
    const vaultList = storeData.phimbot_media_vault || [];

    // merge video base64 จาก key แยก
    const videoKeys = vaultList
      .filter(v => v.videoStorageKey && v.videoStorageKey !== 'storage_failed' && !v.videoBase64)
      .map(v => v.videoStorageKey);
    if (videoKeys.length > 0) {
      const videoData = await chrome.storage.local.get(videoKeys);
      for (const item of vaultList) {
        if (item.videoStorageKey && videoData[item.videoStorageKey]) {
          item.videoBase64 = videoData[item.videoStorageKey];
        }
      }
    }

    // filter: ยังไม่โพสต์ + มี videoBase64 จริง + เฉพาะ batch ปัจจุบันเท่านั้น
    const unposted = vaultList.filter(v =>
      !v.posted?.tiktok && !v.posted?.shopee && !v.posted?.reels && v.videoBase64 && v.videoBase64.length > 100
      && v.createdAt && v.createdAt >= batchStartTime
    );

    addMonitorLog(`📊 คลังวีดีโอทั้งหมด: ${vaultList.length} คลิป | คลิปใหม่ในรอบนี้: ${unposted.length} คลิป`, 'INFO');

    if (unposted.length === 0) {
      addMonitorLog('ℹ️ ไม่พบคลิปใหม่ใน batch นี้', 'INFO');
      showToast('ℹ️ ไม่พบคลิปใหม่สำหรับดำเนินการ');
      return { tiktok: 0, shopee: 0, reels: 0, cloudSync: 0, total: 0 };
    }

    // ═══ vault_only → เก็บในคลังวีดีโอเรียบร้อย (ไม่โพสต์) ═══
    if (target === 'vault_only') {
      addMonitorLog(`💾 บันทึก ${unposted.length} คลิปไว้ใน "คลังวีดีโอ" เรียบร้อย (โหมดเก็บในคลัง)`, 'INFO');
      showToast(`💾 เก็บ ${unposted.length} คลิปในคลังเรียบร้อย — ไปแท็บ "คลัง" เพื่อเลือกโพสต์หรือติดตะกร้าทีหลัง`, 5000);
      return { tiktok: 0, shopee: 0, reels: 0, cloudSync: 0, total: unposted.length, vaultOnly: true };
    }

    // ═══ ดำเนินการส่งต่องานอัตโนมัติ 100% (ไม่มี confirm popup ขัดจังหวะ) ═══
    addMonitorLog(`🚀 เริ่มส่งต่อ ${unposted.length} คลิปไปยัง "${TARGET_LABELS[target] || target}" อัตโนมัติ...`, 'POST');
    let tiktokCount = 0;
    let shopeeCount = 0;
    let reelsCount = 0;
    let cloudSyncCount = 0;
    let errorCount = 0;

    const intervalMinutes = parseInt($('#factoryQueueInterval')?.value || '30', 10) || 30;

    for (let i = 0; i < unposted.length; i++) {
      const vid = unposted[i];
      const progress = `(${i + 1}/${unposted.length})`;
      const cleanCaption = cleanCaptionText(vid.headline, vid.productName, vid.caption);
      const pHashtags = (Array.isArray(vid.hashtags) && vid.hashtags.length) ? vid.hashtags : resolveProductHashtags(vid);
      const pImg = vid.productImage || resolveProductImage(vid);
      const vThumb = vid.thumbnail || await generateVideoThumbnail(vid.videoBase64);

      // ค้นหาข้อมูลสินค้าที่ตรงกันเพื่อดึงรหัสติดตะกร้า (productId) และลิงก์สินค้าให้ครบถ้วน
      const resolvedMeta = await resolveCatalogProduct(vid, i);
      const matchedProd = resolvedMeta.matched;
      const resolvedProductId = resolvedMeta.productId;
      let resolvedProductUrl = resolvedMeta.productUrl;

      // 1. CLOUD SYNC TARGET (ส่งตรงเข้ามือถือ PUP PAP POST)
      if (target === 'cloud_sync') {
        if (window.ASUClipSync) {
          try {
            const s = await window.ASUClipSync.getClipSyncSettings();
            if (s.pairCode) {
              addMonitorLog(`📲 ${progress} [Cloud Sync] ส่ง "${(vid.productName || '').slice(0, 30)}..." เข้ามือถือ`, 'POST');
              showToast(`📲 ${progress} ส่งมือถือ...`);
              if (!resolvedProductUrl && matchedProd) {
                resolvedProductUrl = window.ASUClipSync.resolveClipSyncProductUrl(matchedProd);
              }
              const pushRes = await window.ASUClipSync.pushClipToRelay(vid.videoBase64, {
                sourceMode: 'autopilot',
                productTitle: vid.productName || vid.headline || '',
                productUrl: resolvedProductUrl,
                caption: cleanCaption,
                hashtags: pHashtags.join(' ')
              });
              if (pushRes && pushRes.success) {
                await sendMsg('PHIMBOT_VAULT_MARK_POSTED', { id: vid.id, platform: 'shopee' });
                cloudSyncCount++;
                addMonitorLog(`✅ ${progress} [Cloud Sync] ส่งเข้ามือถือเรียบร้อย`, 'POST');
              } else {
                errorCount++;
                addMonitorLog(`❌ ${progress} [Cloud Sync] ส่งไม่สำเร็จ: ${pushRes?.error || 'unknown'}`, 'ERROR');
              }
            } else {
              errorCount++;
              addMonitorLog(`⚠️ ${progress} [Cloud Sync] ไม่พบรหัสจับคู่มือถือ (กรุณาตั้งค่าในแท็บตั้งค่า)`, 'ERROR');
            }
          } catch (e) {
            errorCount++;
            addMonitorLog(`❌ ${progress} [Cloud Sync] เกิดข้อผิดพลาด: ${e.message}`, 'ERROR');
          }
        } else {
          errorCount++;
          addMonitorLog(`❌ ${progress} [Cloud Sync] ไม่พบโมดูล ASUClipSync`, 'ERROR');
        }
      }

      // 2. FACEBOOK REELS TARGET
      else if (target === 'reels_now') {
        try {
          addMonitorLog(`📤 ${progress} [Reels] บรรจุ "${(vid.productName || '').slice(0, 30)}..." ลงคิว Reels`, 'POST');
          const safeName = (vid.productName || 'reel').replace(/[^a-zA-Z0-9]/g, '_').slice(0, 40);
          const reelsJob = {
            id: `phim_fb_${Date.now()}_${Math.random().toString(36).slice(2, 6)}_${i}`,
            platform: 'fb-reels',
            filename: `${safeName}_${Date.now()}.mp4`,
            videoDataUrl: vid.videoBase64,
            caption: cleanCaption,
            hashtags: ['reels', 'reelsfb', 'ของดีบอกต่อ', 'รีวิว'],
            status: 'pending',
            createdAt: new Date().toISOString(),
            scheduleMode: 'now',
            needsAiCaption: true,
            aiContext: {
              productName: vid.productName || 'สินค้า',
              productDesc: vid.headline || '',
              affiliateUrl: resolvedProductUrl,
              videoIndex: i,
              totalVideos: unposted.length
            }
          };
