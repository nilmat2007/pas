                      target: { tabId: metaTab.id, allFrames: false },
                      func: () => {
                        const exported = window.__META_AI_EXPORT_VIDEOS__;
                        return {
                          exportCount: Array.isArray(exported) ? exported.length : 0,
                          videos: Array.isArray(exported) ? exported.map(v => ({
                            base64: v.base64,
                            timestamp: v.timestamp,
                            promptTimestamp: v.promptTimestamp || 0,
                            thumbnail: v.thumbnail || ''
                          })) : []
                        };
                      }
                    });

                    const metaData = results?.[0]?.result;
                    if (metaData?.exportCount > 0) {
                      for (let vi = 0; vi < metaData.videos.length; vi++) {
                        const vid = metaData.videos[vi];
                        if (!vid.base64 || vid.base64.length < 100) continue;

                        if (vid.promptTimestamp && vid.promptTimestamp < promptTimestamp - 5000) {
                          continue;
                        }

                        const dedupKey = `${vid.timestamp || ''}_${vid.base64.length}`;
                        if (savedTimestamps.has(dedupKey)) continue;
                        savedTimestamps.add(dedupKey);

                        const itemId = `meta_vid_${Date.now()}_${vi}`;
                        const videoKey = `phimbot_video_${itemId}`;

                        await chrome.storage.local.set({ [videoKey]: vid.base64 });

                        const storeNow = await chrome.storage.local.get(['phimbot_media_vault']);
                        const vaultNow = storeNow.phimbot_media_vault || [];
                        const itemPlatform = prod.platform || ((prod.productUrl || '').includes('shopee') ? 'shopee' : 'tiktok');
                        const clipTitle = `${prod.name} [คลิป ${varIdx + 1}/${metaClipsPerProduct} - ${hookVariation.title}${metaSceneCount > 1 ? ` ฉาก ${sceneIdx + 1}` : ''}]`;
                        const pHashtags = resolveProductHashtags(prod);
                        const pImg = resolveProductImage(prod);
                        const vThumb = vid.thumbnail || await generateVideoThumbnail(vid.base64);

                        vaultNow.unshift({
                          id: itemId,
                          productName: prod.name,
                          headline: clipTitle,
                          productId: prod.tiktokProductId || '',
                          productUrl: prod.productUrl || '',
                          videoBase64: '',
                          videoStorageKey: videoKey,
                          videoBase64Size: vid.base64.length,
                          thumbnail: vThumb,
                          productImage: pImg,
                          caption: prod.name,
                          hashtags: pHashtags,
                          platform: itemPlatform,
                          source: 'meta_ai',
                          posted: { tiktok: false, reels: false, shopee: false },
                          createdAt: new Date().toISOString()
                        });
                        await chrome.storage.local.set({ phimbot_media_vault: vaultNow });
                        metaVideosReceived++;

                        // Preview in monitor
                        const monVid = $('#monVideoPreview');
                        if (monVid && vid.base64) {
                          monVid.innerHTML = `<video src="${vid.base64}" autoplay loop muted playsinline style="width:100%;height:100%;object-fit:cover;border-radius:8px;"></video>`;
                        }

                        addMonitorLog(`    💾 บันทึกคลิป "${clipTitle}" (${(vid.base64.length / 1024 / 1024).toFixed(1)} MB) เข้า Vault แล้ว`, 'SUCCESS');
                      }

                      // Clear exported videos
                      await chrome.scripting.executeScript({
                        target: { tabId: metaTab.id, allFrames: false },
                        func: () => { window.__META_AI_EXPORT_VIDEOS__ = []; }
                      });

                      clearInterval(metaPollTimer);
                      resolve({ success: true, count: metaData.exportCount });
                      return;
                    }

                    if (metaPollCount % 12 === 0) {
                      const elapsed = Math.round(metaPollCount * 5 / 60);
                      addMonitorLog(`    ⏳ ผ่านไปแล้ว ${elapsed} นาที — กำลังรอ Meta AI ผลิตวิดีโอ...`);
                    }

                    if (metaPollCount >= maxMetaPoll) {
                      clearInterval(metaPollTimer);
                      addMonitorLog('    ⌛ หมดเวลารอ Meta AI สำหรับฉากนี้ (15 นาที)', 'WARN');
                      resolve({ success: false, count: 0 });
                    }
                  } catch (pollErr) {
                    console.warn('[AutoPilot Meta] Poll error:', pollErr);
                  }
                }, 5000);
              });

              completedSteps++;
              const curPct = Math.min(100, Math.round((completedSteps / Math.max(1, totalClipsPlanned)) * 100));
              const monBar = $('#monProgressBar');
              if (monBar) monBar.style.width = `${curPct}%`;

              // พัก 4 วินาทีเพื่อให้ Meta AI หน้าจอคลายตัวก่อนส่งรอบถัดไป
              if (!isFactoryAborted && completedSteps < totalClipsPlanned) {
                addMonitorLog('    ☕ พัก 4 วินาที ก่อนส่งงานต่อไป...');
                await new Promise(r => setTimeout(r, 4000));
              }
            } // end scene loop
          } // end variation loop
        } // end product loop

        // ═══ Meta AI Step 4: Auto-Post ═══
        if (metaVideosReceived > 0) {
          addMonitorLog(`📤 สเต็ป 4: ดำเนินการโพสต์ตามเป้าหมาย (${factoryPostTarget})...`, 'POST');
          btn.innerHTML = '📤 สเต็ป 4: กำลังดำเนินการโพสต์...';
          showToast(`📤 สเต็ป 4/4: ${factoryPostTarget === 'vault_only' ? 'เก็บในคลัง' : 'เตรียมโพสต์'}...`);
          const postResult = await executeAutoPostTarget(factoryPostTarget, batchStartTime);
          // สรุปผลสุดท้าย
          const parts = [`ผลิต ${metaVideosReceived} คลิป`];
          if (postResult?.tiktok > 0) parts.push(`TikTok ${postResult.tiktok}`);
          if (postResult?.shopee > 0) parts.push(`Shopee ${postResult.shopee}`);
          if (postResult?.vaultOnly) parts.push('เก็บในคลัง');
          if (postResult?.cancelled) parts.push('ยกเลิกโพสต์');
          addMonitorLog(`🏁 จบ Auto-Pilot (Meta AI): ${parts.join(' | ')}`, 'SUCCESS');
          showToast(`🎉 สำเร็จ! ${parts.join(' | ')}`, 6000);
          const monBar = $('#monProgressBar');
          if (monBar) monBar.style.width = '100%';
          setMonitorCompletedState(metaVideosReceived);
        } else {
          addMonitorLog('ℹ️ ไม่มีวิดีโอใหม่จาก Meta AI สำหรับโพสต์');
          showToast('ℹ️ ไม่มีวิดีโอใหม่', 4000);
          if (isFactoryAborted) {
            setMonitorAbortedState();
          } else {
            setMonitorCompletedState(0);
          }
        }

        // Skip Google Flow pipeline
        isFactoryBusy = false;
        btn.disabled = false;
        btn.innerHTML = origHtml;
        return; // ← ออกจาก handler เลย ไม่เข้า Google Flow pipeline
      }

      // ╔═══════════════════════════════════════════════════════════════════╗
      // ║  GOOGLE FLOW PIPELINE (Ai SALER PRO)                            ║
      // ╚═══════════════════════════════════════════════════════════════════╝

      // Helper: ติดตั้ง/อัปเดต Video Interceptor v2 เข้าทุก frame ของ Google Flow (รวมถึง blob: iframe)
      const installOrUpdateFlowInterceptor = async () => {
        for (const tab of flowTabs) {
          try {
            await chrome.scripting.executeScript({
              target: { tabId: tab.id, allFrames: true },
              world: 'MAIN',
              func: (productsList, targetScenes) => {
                // อัปเดตข้อมูลสินค้าและรีเซ็ตคิวสำหรับรอบการผลิตใหม่ทุกครั้ง
                window.__PHIMBOT_PRODUCTS__ = Array.isArray(productsList) ? productsList : [];
                window.__PHIMBOT_CURRENT_PRODUCT__ = window.__PHIMBOT_PRODUCTS__[0] || {};
                window.__PHIMBOT_TARGET_SCENES__ = Number(targetScenes) || 1;
                window.__FLOW_EXPORT_VIDEOS__ = [];
                window.__FLOW_SCENE_FALLBACK_VIDEOS__ = [];
                window.__PHIMBOT_CAPTURED_SIGS__ = new Set();
                window.__PHIMBOT_FALLBACK_SIGS__ = new Set();

                // ปรับแต่ง Margin & Padding ของหน้าต่าง Tool ใน iframe ให้สวยงาม ไม่ซ้อนทับกัน
                try {
                  if (location.href.includes('scf.usercontent.goog') || document.getElementById('tiktok-product-id') || document.querySelector('[data-state]')) {
                    if (!document.getElementById('phimbot-flow-tool-spacing-fix')) {
                      const style = document.createElement('style');
                      style.id = 'phimbot-flow-tool-spacing-fix';
                      style.textContent = `
                        body { padding: 14px 18px !important; box-sizing: border-box !important; }
                        section, [class*="card"], [class*="panel"] { margin-bottom: 14px !important; }
                        button, [role="button"] { margin: 2px !important; }
                        input, select, textarea { margin-top: 4px !important; margin-bottom: 6px !important; }
                        [class*="aspect-[9/16]"] { max-height: 44vh !important; width: auto !important; margin-top: 36px !important; margin-bottom: 12px !important; }
                      `;
                      (document.head || document.documentElement).appendChild(style);
                    }
                  }
                } catch (_) {}

                // ฟังก์ชันช่วยดึงข้อมูลสินค้าที่ Tool กำลังผลิตอยู่จริงในขณะนั้น
                window.__phimbotResolveProductMeta = () => {
                  const cleanId = (v) => {
                    const s = String(v || '').trim();
                    if (!s || /^(PID_)?UNKNOWN$/i.test(s) || /^null$/i.test(s) || /^undefined$/i.test(s)) return '';
                    return s.replace(/^PID_/i, '').trim();
                  };
                  const list = window.__PHIMBOT_PRODUCTS__ || [];
                  const domId = cleanId(document.getElementById('tiktok-product-id')?.value);
                  const domName = String(document.getElementById('active-product-name')?.value || '').trim();
                  let matched = null;
                  if (domId) {
                    matched = list.find(p => cleanId(p.tiktokProductId) === domId);
                  }
                  if (!matched && domName) {
                    matched = list.find(p => String(p.name || '').trim() === domName);
                  }
                  if (!matched) {
                    matched = window.__PHIMBOT_CURRENT_PRODUCT__ || list[0] || {};
                  }
                  const pName = domName || matched.name || 'สินค้าจาก AI SALER PRO';
                  const pId = domId || cleanId(matched.tiktokProductId);
                  const pUrl = matched.productUrl || '';
                  const platform = matched.platform || (pUrl.includes('shopee') ? 'shopee' : 'tiktok');
                  return { pName, pId, pUrl, platform };
                };

                // ฟังก์ชันกลางสำหรับบันทึก base64 วิดีโอลงคิวส่งออก (หรือคิวสำรองกรณีแยกฉาก)
                window.__phimbotPushBase64Video = (rawBase64, sourceLabel = 'interceptor', isSceneFallback = false) => {
                  try {
                    if (!rawBase64 || typeof rawBase64 !== 'string') return false;
                    let base64 = rawBase64.trim();
                    if (base64.startsWith('data:application/octet-stream')) {
                      base64 = base64.replace('data:application/octet-stream', 'data:video/mp4');
                    } else if (!base64.startsWith('data:')) {
                      base64 = 'data:video/mp4;base64,' + base64;
                    }
                    if (base64.length < 60000) return false;

                    const sig = `${base64.length}_${base64.slice(80, 160)}_${base64.slice(-80)}`;
                    const sigSet = isSceneFallback ? window.__PHIMBOT_FALLBACK_SIGS__ : window.__PHIMBOT_CAPTURED_SIGS__;
                    if (sigSet.has(sig)) {
                      return false;
                    }
                    sigSet.add(sig);

                    const { pName, pId, pUrl, platform } = window.__phimbotResolveProductMeta();
                    const payload = {
                      productId: pId,
                      productName: pName,
                      productUrl: pUrl,
                      headline: pName + ' รีวิวของดีบอกต่อ',
                      videoBase64: base64,
                      videoUrl: '',
                      thumbnail: '',
                      caption: pName + ' รีวิวของดีบอกต่อ',
                      hashtags: platform === 'shopee' ? '#ShopeeTH #ShopeeVideo #รีวิว' : '#TikTokShop #ของดีบอกต่อ #รีวิว',
                      platform,
                      source: sourceLabel,
                      isFallback: isSceneFallback,
                      capturedAt: Date.now()
                    };

                    if (isSceneFallback) {
                      window.__FLOW_SCENE_FALLBACK_VIDEOS__.push(payload);
                      console.log(`[PhimBot Interceptor v2] 🛡️ Stored scene fallback (${sourceLabel}) → total fallbacks:`, window.__FLOW_SCENE_FALLBACK_VIDEOS__.length);
                    } else {
                      window.__FLOW_EXPORT_VIDEOS__.push(payload);
                      const msg = { type: 'EXT_EXPORT_VIDEO', payload };
                      window.postMessage(msg, '*');
                      try { window.parent.postMessage(msg, '*'); } catch (_) {}
                      console.log(`[PhimBot Interceptor v2] 🎯 Captured FINAL video (${sourceLabel}) → total exported:`, window.__FLOW_EXPORT_VIDEOS__.length);
                    }
                    return true;
                  } catch (err) {
                    console.warn('[PhimBot Interceptor v2] pushBase64 error:', err);
                    return false;
                  }
                };

                window.__phimbotExportVideoBlob = (blobOrBytes, sourceLabel = 'interceptor', isSceneFallback = false) => {
                  try {
                    const blob = blobOrBytes instanceof Blob
                      ? (blobOrBytes.type ? blobOrBytes : new Blob([blobOrBytes], { type: 'video/mp4' }))
                      : new Blob([blobOrBytes], { type: 'video/mp4' });
                    if (blob.size < 45000) return;
                    const reader = new FileReader();
                    reader.__phimbotInternal = true;
                    reader.onload = () => {
                      window.__phimbotPushBase64Video(reader.result, sourceLabel, isSceneFallback);
                    };
                    reader.readAsDataURL(blob);
                  } catch (_) {}
                };

                // ฟังก์ชันดักจับ Flow.download (เรียกเมื่อ finalizeCampaign รวมฉากเสร็จสมบูรณ์)
                const hookFlowDownloadObj = () => {
                  try {
                    if (window.Flow && typeof window.Flow.download === 'function' && !window.Flow.download.__phimbotHooked) {
                      const origDl = window.Flow.download.bind(window.Flow);
                      const wrappedDl = async function(opts) {
                        try {
                          if (opts && opts.base64 && (!opts.mimeType || opts.mimeType.includes('video') || String(opts.filename || '').endsWith('.mp4'))) {
                            console.log('[PhimBot Interceptor v2] 🎯 Intercepted Flow.download:', opts.filename);
                            window.__phimbotPushBase64Video(opts.base64, 'flow_download', false);
                          }
                        } catch (e) {
                          console.warn('[PhimBot Interceptor v2] Flow.download hook warn:', e);
                        }
                        return origDl(opts);
                      };
                      wrappedDl.__phimbotHooked = true;
                      window.Flow.download = wrappedDl;
                    }
                  } catch (_) {}
                };
                hookFlowDownloadObj();

                if (window.__PHIMBOT_VIDEO_INTERCEPTOR_V2__) return 'updated_v2';
                window.__PHIMBOT_VIDEO_INTERCEPTOR_V2__ = true;

                // คอยตรวจจับหาก window.Flow ถูกสร้างทีหลัง
                setInterval(hookFlowDownloadObj, 1000);

                // 1. ดักจับ FileReader.prototype.readAsDataURL
                // ใน App.tsx: finalizeCampaign เท่านั้นที่ใช้ FileReader.readAsDataURL(new Blob([res])) เพื่อแปลงไฟล์รวม out.mp4!
                const origReadAsDataURL = FileReader.prototype.readAsDataURL;
                FileReader.prototype.readAsDataURL = function(blob) {
                  if (!this.__phimbotInternal && blob instanceof Blob && blob.size > 45000) {
                    const isVideoOrRaw = !blob.type || blob.type.startsWith('video/') || blob.type === 'application/octet-stream';
                    if (isVideoOrRaw) {
                      this.addEventListener('loadend', () => {
                        try {
                          if (typeof this.result === 'string' && this.result.length > 60000) {
                            console.log('[PhimBot Interceptor v2] 🎯 Captured merged video via FileReader.readAsDataURL:', blob.size, 'bytes');
                            window.__phimbotPushBase64Video(this.result, 'filereader_finalize_mp4', false);
                          }
                        } catch (_) {}
                      }, { once: true });
                    }
                  }
                  return origReadAsDataURL.apply(this, arguments);
                };

                // 2. ดักจับ FFmpeg Web Worker (บังคับแปลงเสียง 44.1kHz Stereo + ดึงไฟล์ out.mp4 ที่รวมฉากเสร็จแล้วโดยตรง)
                const origWorkerPost = Worker.prototype.postMessage;
                Worker.prototype.postMessage = function(msg, transfer) {
                  try {
                    if (msg && msg.type === 'EXEC' && msg.data && Array.isArray(msg.data.args)) {
                      const args = msg.data.args;
                      const copyIdx = args.indexOf('-c');
                      if (args.includes('out.mp4') && copyIdx !== -1 && args[copyIdx + 1] === 'copy') {
                        const newArgs = [
                          ...args.slice(0, copyIdx),
                          '-c:v', 'copy',
                          '-c:a', 'aac',
                          '-ar', '44100',
                          '-ac', '2',
                          '-b:a', '128k',
                          ...args.slice(copyIdx + 2)
                        ];
                        msg.data.args = newArgs;
                        console.log('[PhimBot Interceptor v2] 🔊 Upgraded FFmpeg concat args to 44.1kHz Stereo:', newArgs.join(' '));
                      }
                    }
                    if (msg && msg.type === 'READ_FILE' && msg.data && msg.data.path === 'out.mp4') {
                      const reqId = msg.id;
                      const onWorkerMsg = (ev) => {
                        if (ev.data && ev.data.id === reqId) {
                          this.removeEventListener('message', onWorkerMsg);
                          if (ev.data.data instanceof Uint8Array && ev.data.data.byteLength > 45000) {
                            console.log('[PhimBot Interceptor v2] 🎯 Captured final merged out.mp4 from FFmpeg Worker:', ev.data.data.byteLength);
                            window.__phimbotExportVideoBlob(ev.data.data, 'ffmpeg_out_mp4', false);
                          }
                        }
                      };
                      this.addEventListener('message', onWorkerMsg);
                    }
                  } catch (wErr) {
                    console.warn('[PhimBot Interceptor v2] Worker hook warn:', wErr);
                  }
                  return origWorkerPost.apply(this, arguments);
                };

                // 3. ดักจับ URL.createObjectURL — ถ้า 1 ฉากให้ส่งออกเลย แต่ถ้าหลายฉากให้เก็บเป็น Scene Fallback เผื่อ FFmpeg ล้มเหลว
                const origCreate = URL.createObjectURL.bind(URL);
                URL.createObjectURL = function(blob) {
                  const url = origCreate(blob);
                  try {
                    if (blob instanceof Blob && blob.type && blob.type.startsWith('video/') && blob.size > 45000) {
                      if ((window.__PHIMBOT_TARGET_SCENES__ || 1) <= 1) {
                        window.__phimbotExportVideoBlob(blob, 'createObjectURL_single', false);
                      } else {
                        window.__phimbotExportVideoBlob(blob, 'createObjectURL_scene_fallback', true);
                        console.log('[PhimBot Interceptor v2] ⏳ Multi-scene preview stored in fallback, waiting for merged out.mp4...');
                      }
                    }
                  } catch (_) {}
                  return url;
                };

                // 4. ดักจับ <a>.click() — จับ auto-download
                const origClick = HTMLAnchorElement.prototype.click;
                HTMLAnchorElement.prototype.click = function() {
                  if (this.download && this.href && this.href.startsWith('blob:')) {
                    fetch(this.href).then(r => r.blob()).then(blob => {
                      if (blob.size > 45000) window.__phimbotExportVideoBlob(blob, 'anchor_download', false);
                    }).catch(() => {});
                  }
                  return origClick.call(this);
                };

                // 5. ดักจับ Blob constructor สำหรับ raw Uint8Array MP4 bytes จาก finalizeCampaign
                const OrigBlob = window.Blob;
                window.Blob = function(parts, options) {
                  const blob = new OrigBlob(parts, options);
                  try {
                    if (blob.size > 45000 && Array.isArray(parts) && parts[0] instanceof Uint8Array && parts[0].byteLength > 45000) {
                      const b = parts[0];
                      // ตรวจ MP4 'ftyp' header ที่ byte 4..7
                      if (b[4] === 0x66 && b[5] === 0x74 && b[6] === 0x79 && b[7] === 0x70) {
                        // ถ้าไม่ได้มาจาก b64ToUint8 ของฉากย่อย หรือถ้ามีแค่ 1 ฉาก
                        if (!options?.type || (window.__PHIMBOT_TARGET_SCENES__ || 1) <= 1) {
                          window.__phimbotExportVideoBlob(blob, 'finalize_mp4_blob', false);
                        }
                      }
                    }
                  } catch (_) {}
                  return blob;
                };
                window.Blob.prototype = OrigBlob.prototype;

                console.log('[PhimBot Interceptor v2] ✅ Ready — Flow.download + FileReader + FFmpeg out.mp4 + Scene Fallback');
                return 'injected_v2';
              },
              args: [convertedProducts, sceneCount]
            });
          } catch (e) {
            console.warn('[AutoPilot v3] Interceptor inject warn:', e);
          }
        }
      };

      // ═══════════ สเต็ป 2: ติดตั้ง Video Interceptor ล่วงหน้า + ส่งข้อมูลไปยัง Tool ═══════════
      addMonitorLog('🎬 กำลังติดตั้ง Video Interceptor v2 ล่วงหน้าก่อนเริ่มสายการผลิต...');
      await installOrUpdateFlowInterceptor();

      addMonitorLog('⚡ สเต็ป 2: ส่งข้อมูลเข้า Ai SALER PRO + ทริกเกอร์ autoRun...');
      addMonitorLog(`📊 ค่าที่ส่ง: campaignCount=${ideaCount}, sceneCount=${sceneCount}, duration=${duration}`);
      btn.innerHTML = '⚡ ส่งข้อมูลเข้า Tool...';

      const flowBatchStartTime = new Date().toISOString(); // จำเวลาเริ่ม batch สำหรับกรองคลิปใหม่ใน Step 4

      if (typeof window.sendDataToFlowTool === 'function') {
        const sendRes = await window.sendDataToFlowTool(toolPayload);
        if (sendRes?.detail?.foundElement) {
          addMonitorLog('✅ ซิงค์ข้อมูลเข้าสู่ Tool เรียบร้อย — Tool จะเริ่ม Pipeline อัตโนมัติ');
        } else {
          addMonitorLog('⚠️ ส่งข้อมูลแล้วแต่ไม่พบ element ใน Tool — อาจต้องเปิดหน้า Tool ให้ถูกต้อง');
        }
      } else {
        throw new Error('sendDataToFlowTool ยังไม่พร้อม — กรุณารีโหลด Extension');
      }

      // ═══════════ สเต็ป 2.5: Force-inject ค่าเข้า iframe ของ Tool โดยตรง ═══════════
      for (const tab of flowTabs) {
        try {
          await chrome.scripting.executeScript({
            target: { tabId: tab.id, allFrames: true },
            world: 'MAIN',
            func: (cCount, sCount, dur, targetGender) => {
              window.campaignCount = cCount;
              window.sceneCount = sCount;
              window.ideaCount = cCount;
              window.targetSetCount = cCount;
              window.scenes = sCount;
              window.duration = dur;
              window.voiceGender = targetGender;

              if (window.__PHIMBOT_INJECTED_PAYLOAD__?.settings) {
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.campaignCount = cCount;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.sceneCount = sCount;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.ideaCount = cCount;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.targetSetCount = cCount;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.scenes = sCount;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.gender = targetGender;
                window.__PHIMBOT_INJECTED_PAYLOAD__.settings.voiceGender = targetGender;
              }
              if (window.__PHIMBOT_INJECTED_PAYLOAD__?.influencer) {
                window.__PHIMBOT_INJECTED_PAYLOAD__.influencer.gender = targetGender;
                window.__PHIMBOT_INJECTED_PAYLOAD__.influencer.voiceGender = targetGender;
              }

              const countSelectors = [
                'campaignCount', 'campaign-count', 'campaign_count',
                'sceneCount', 'scene-count', 'scene_count',
                'ideaCount', 'idea-count', 'idea_count',
                'targetSetCount', 'target-set-count'
              ];
              countSelectors.forEach(sel => {
                const el = document.getElementById(sel) || document.querySelector(`[name="${sel}"]`);
                if (el) {
                  const val = sel.toLowerCase().includes('scene') ? sCount : cCount;
                  try {
                    const tag = (el.tagName || '').toUpperCase();
                    const win = el.ownerDocument?.defaultView || window;
                    const proto = tag === 'SELECT'
                      ? win.HTMLSelectElement?.prototype
                      : (tag === 'TEXTAREA' ? win.HTMLTextAreaElement?.prototype : (tag === 'INPUT' ? win.HTMLInputElement?.prototype : null));
                    const nativeSet = proto ? Object.getOwnPropertyDescriptor(proto, 'value')?.set : null;
                    if (nativeSet) {
                      nativeSet.call(el, String(val));
                    } else if ('value' in el) {
                      el.value = String(val);
                    }
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                  } catch (_) {
                    try { el.value = String(val); } catch (__) {}
                  }
                }
              });

              const clickGenderBtn = () => {
                const matchText = targetGender === 'male' ? /ชาย\s*\(ครับ\)|^ชาย$/i : /หญิง\s*\(ค่ะ\)|^หญิง$/i;
                const btns = Array.from(document.querySelectorAll('button, [role="button"], [role="tab"]'));
                for (const b of btns) {
                  const txt = (b.innerText || b.textContent || '').replace(/\s+/g, ' ').trim();
                  if (matchText.test(txt)) {
                    b.click();
                  }
                }
              };
              clickGenderBtn();
              setTimeout(clickGenderBtn, 400);
              setTimeout(clickGenderBtn, 1000);
              setTimeout(clickGenderBtn, 2000);
            },
            args: [ideaCount, sceneCount, duration, resolvedGender]
          });
        } catch (e) {
          console.warn('[AutoPilot v3] Force-inject failed for tab:', tab.id, e);
        }
      }
      addMonitorLog(`✅ Force-inject ค่า campaignCount=${ideaCount}, sceneCount=${sceneCount}, เพศ=${resolvedGender === 'male' ? 'ชาย (ครับ)' : 'หญิง (ค่ะ)'} เข้า Tool ทุก iframe`);

      // ยืนยันว่า Video Interceptor v2 พร้อมทำงานในทุก frame
      await installOrUpdateFlowInterceptor();
      addMonitorLog('✅ Video Interceptor v2 (ดักจับวิดีโอรวมฉาก + Fallback อัตโนมัติ) พร้อมทำงาน');

      // ═══════════ สเต็ป 3: Monitor Progress & ดึงวิดีโอเข้าคลังแบบ Real-time ทุก 5 วินาที ═══════════
      addMonitorLog('⏳ สเต็ป 3: Ai SALER PRO กำลังทำงาน — ติดตามสถานะและดึงวิดีโอเข้าคลังอัตโนมัติ...');
      btn.innerHTML = '🎬 Tool กำลังผลิตวิดีโอ...';

      const STATE_LABELS = {
        'idle': '⏸️ รอคำสั่ง',
        'brainstorming': '💡 กำลังคิดไอเดีย + เขียนบท',
        'generating_video': '🎬 กำลังสร้างรูปภาพ + วิดีโอ',
        'done': '✅ ผลิตเสร็จสมบูรณ์'
      };

      let lastState = '';
      let pollCount = 0;
      let videosReceived = 0;
      let wasGenerating = false;
      let activeGenerationTicks = 0;
      let isDraining = false;
      const savedBatchVideoSigs = new Set();
      const expectedVideos = Math.max(1, toolPayload.products.length * ideaCount);
      const maxPollCount = 360; // 30 นาที (5s × 360)

      // Helper: บันทึกรายการวิดีโอที่ดึงมาจาก Tool ลงคลังวีดีโอ (Two-Tier Storage) ทันที
      const saveCapturedVideoToVault = async (vid, indexInBatch) => {
        if (!vid || !vid.videoBase64) return false;
        let vb64 = vid.videoBase64.trim();
        if (vb64.startsWith('data:application/octet-stream')) {
          vb64 = vb64.replace('data:application/octet-stream', 'data:video/mp4');
        } else if (!vb64.startsWith('data:')) {
          vb64 = 'data:video/mp4;base64,' + vb64;
        }
        if (vb64.length < 60000) return false;

        const sig = `${vb64.length}_${vb64.slice(80, 160)}_${vb64.slice(-80)}`;
        if (savedBatchVideoSigs.has(sig)) return false;
        savedBatchVideoSigs.add(sig);

        // จับคู่ข้อมูลสินค้าและรหัสสินค้าสำหรับติดตะกร้าให้แม่นยำ (รองรับทั้ง factoryProducts และ phimbot_products)
        const fallbackProd = convertedProducts[indexInBatch % Math.max(1, convertedProducts.length)] || convertedProducts[0] || {};
        const matchedProd = convertedProducts.find(p =>
          (cleanProductId(vid.productId) && cleanProductId(p.tiktokProductId) === cleanProductId(vid.productId)) ||
          (vid.productName && p.name === vid.productName)
        ) || fallbackProd;

        const catalogResolved = await resolveCatalogProduct({
          productId: cleanProductId(vid.productId) || cleanProductId(matchedProd.tiktokProductId),
          productName: vid.productName || matchedProd.name || '',
          productUrl: vid.productUrl || matchedProd.productUrl || '',
          platform: vid.platform || matchedProd.platform || '',
          productImage: matchedProd.image || '',
        }, indexInBatch);

        const resolvedPid = catalogResolved.productId || cleanProductId(matchedProd.tiktokProductId);
        const cleanProductName = catalogResolved.productName || vid.productName || matchedProd.name || 'สินค้าจาก AI SALER PRO';
        const cleanProductUrl = catalogResolved.productUrl || vid.productUrl || matchedProd.productUrl || '';
        const cleanPlatform = catalogResolved.platform || vid.platform || matchedProd.platform || (cleanProductUrl.includes('shopee') ? 'shopee' : 'tiktok');

        addMonitorLog(`💾 กำลังบันทึกคลิป "${cleanProductName}" (PID: ${resolvedPid || 'N/A'}, ${(vb64.length / 1024 / 1024).toFixed(1)} MB) เข้าคลังวีดีโอ...`);

        try {
          const itemId = `vid_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`;
          const videoKey = `phimbot_video_${itemId}`;

          // 1) เก็บ video base64 ใน key แยก
          await chrome.storage.local.set({ [videoKey]: vb64 });

          // 2) อ่านคลังวีดีโอปัจจุบันแล้วเพิ่มรายการใหม่
          const storeNow = await chrome.storage.local.get(['phimbot_media_vault']);
          const vault = storeNow.phimbot_media_vault || [];

          const flowHashtags = resolveProductHashtags({ ...vid, productId: resolvedPid, productName: cleanProductName });
          const pImg = catalogResolved.productImage || resolveProductImage({ ...vid, productId: resolvedPid, productName: cleanProductName });
          const vThumb = vid.thumbnail || await generateVideoThumbnail(vb64);

          const newItem = {
            id: itemId,
            productId: resolvedPid,
            productName: cleanProductName,
            productUrl: cleanProductUrl,
            headline: vid.headline || `${cleanProductName} รีวิวของดีบอกต่อ`,
            videoBase64: '', // เก็บแยกใน videoStorageKey เพื่อความเร็วและไม่ติดโควตา
            videoStorageKey: videoKey,
            videoBase64Size: vb64.length,
            videoUrl: vid.videoUrl || '',
            thumbnail: vThumb,
            productImage: pImg,
            caption: vid.caption || `${cleanProductName} รีวิวของดีบอกต่อ`,
            hashtags: flowHashtags,
            platform: cleanPlatform,
            source: vid.source || 'flow_autopilot',
            createdAt: new Date().toISOString(),
            posted: { tiktok: false, reels: false, shopee: false }
          };

          vault.unshift(newItem);
          await chrome.storage.local.set({ phimbot_media_vault: vault });

          videosReceived++;
          const pct = Math.min(100, Math.round((videosReceived / expectedVideos) * 100));
          const bar = $('#monProgressBar');
          if (bar) bar.style.width = `${pct}%`;

          // แสดงตัวอย่างวิดีโอสดใน Production Monitor ของ Extension
          const monVid = $('#monVideoPreview');
          if (monVid) {
            monVid.innerHTML = `<video src="${vb64}" autoplay loop muted playsinline style="width:100%;height:100%;object-fit:cover;border-radius:8px;"></video>`;
          }

          addMonitorLog(`✅ บันทึก "${cleanProductName}" เข้าคลังวีดีโอสำเร็จ! (${videosReceived}/${expectedVideos} คลิป | รหัสตะกร้า: ${cleanProductId || 'ไม่มี'})`, 'SUCCESS');
          try { await refreshVault(); } catch (_) {}
          return true;
        } catch (saveErr) {
          addMonitorLog(`❌ บันทึกเข้าคลังล้มเหลว: ${saveErr.message}`, 'ERROR');
          return false;
        }
      };

      // Helper: ดึงวิดีโอจาก window.__FLOW_EXPORT_VIDEOS__ (และ fallback ถ้าจำเป็น) ในทุก iframe ของ Google Flow
      const drainAndSaveFlowVideosToVault = async ({ allowFallback = false } = {}) => {
        if (isDraining) return 0;
        isDraining = true;
        let newlySaved = 0;
        try {
          for (const tab of flowTabs) {
            try {
              const drainResults = await chrome.scripting.executeScript({
                target: { tabId: tab.id, allFrames: true },
                world: 'MAIN',
                func: async (useFallback) => {
                  const out = [];
                  // 1) ดึงวิดีโอตัวเต็มที่รวมฉากเสร็จแล้วจาก __FLOW_EXPORT_VIDEOS__
                  if (Array.isArray(window.__FLOW_EXPORT_VIDEOS__) && window.__FLOW_EXPORT_VIDEOS__.length > 0) {
                    const drained = window.__FLOW_EXPORT_VIDEOS__.splice(0, window.__FLOW_EXPORT_VIDEOS__.length);
                    out.push(...drained);
                  }
                  // 2) ถ้าสั่งใช้ Fallback (กรณีหลายฉากแล้ว FFmpeg รวมไฟล์ไม่สำเร็จ) ให้ดึงจาก __FLOW_SCENE_FALLBACK_VIDEOS__
                  if (useFallback && out.length === 0 && Array.isArray(window.__FLOW_SCENE_FALLBACK_VIDEOS__) && window.__FLOW_SCENE_FALLBACK_VIDEOS__.length > 0) {
                    const fbDrained = window.__FLOW_SCENE_FALLBACK_VIDEOS__.splice(0, window.__FLOW_SCENE_FALLBACK_VIDEOS__.length);
                    out.push(...fbDrained);
                  }
                  // 3) ถ้ายังว่างและสั่งใช้ Fallback ให้ลองดึงจาก <video src="blob:..."> ในหน้า Tool
                  if (useFallback && out.length === 0 && location.href.includes('scf.usercontent.goog')) {
                    const videos = Array.from(document.querySelectorAll('video'));
                    for (const v of videos) {
                      const src = v.currentSrc || v.src || '';
                      if (src.startsWith('blob:')) {
                        try {
                          const resp = await fetch(src);
                          const blob = await resp.blob();
                          if (blob.size > 45000 && blob.type.startsWith('video/')) {
                            const b64 = await new Promise((res) => {
                              const r = new FileReader();
                              r.__phimbotInternal = true;
                              r.onload = () => res(r.result);
                              r.onerror = () => res('');
                              r.readAsDataURL(blob);
                            });
                            if (b64) {
                              const meta = typeof window.__phimbotResolveProductMeta === 'function'
                                ? window.__phimbotResolveProductMeta()
                                : { pName: 'สินค้าจาก AI SALER PRO', pId: '', pUrl: '', platform: 'tiktok' };
                              out.push({
                                productId: meta.pId,
                                productName: meta.pName,
                                productUrl: meta.pUrl,
                                headline: meta.pName + ' รีวิวของดีบอกต่อ',
                                videoBase64: b64,
                                caption: meta.pName + ' รีวิวของดีบอกต่อ',
                                platform: meta.platform,
                                source: 'dom_video_fallback'
                              });
                            }
                          }
                        } catch (_) {}
                      }
                    }
                  }
                  return out;
                },
                args: [allowFallback]
              });

              for (const res of (drainResults || [])) {
                if (!Array.isArray(res?.result) || res.result.length === 0) continue;
                for (const vid of res.result) {
                  const ok = await saveCapturedVideoToVault(vid, videosReceived);
                  if (ok) newlySaved++;
                }
              }
            } catch (tabErr) {
              console.warn('[AutoPilot v3] Drain warn for tab', tab.id, tabErr);
            }
          }
        } finally {
          isDraining = false;
        }
        return newlySaved;
      };

      await new Promise((resolve, reject) => {
        const pollTimer = setInterval(async () => {
          if (isFactoryAborted) {
            clearInterval(pollTimer);
            resolve();
            return;
          }
          pollCount++;

          try {
            // 3A. ตรวจสอบสถานะ Tool + ตรวจว่าหน้า ProductionMonitor ยังเปิดทำงานอยู่หรือไม่
            let currentState = 'idle';
            let hasMonitorOverlay = false;
            let pendingExportInFrame = 0;
            let pendingFallbackInFrame = 0;

            for (const tab of flowTabs) {
              try {
                const statusResults = await chrome.scripting.executeScript({
                  target: { tabId: tab.id, allFrames: true },
                  world: 'MAIN',
                  func: () => {
                    const stateEl = document.querySelector('[data-state]');
                    const dataState = stateEl ? stateEl.getAttribute('data-state') : null;
                    const bodyText = document.body?.innerText || '';
                    const monitorActive = Boolean(
                      bodyText.includes('หน้าจอแสดงผลสดจากระบบ') ||
                      bodyText.includes('AI_PROD_OS') ||
                      Array.from(document.querySelectorAll('button')).some(b => (b.innerText || '').includes('หยุดผลิต'))
                    );
                    const exportLen = Array.isArray(window.__FLOW_EXPORT_VIDEOS__) ? window.__FLOW_EXPORT_VIDEOS__.length : 0;
                    const fallbackLen = Array.isArray(window.__FLOW_SCENE_FALLBACK_VIDEOS__) ? window.__FLOW_SCENE_FALLBACK_VIDEOS__.length : 0;
                    return { dataState, monitorActive, exportLen, fallbackLen };
                  }
                });
                for (const sr of (statusResults || [])) {
                  const d = sr?.result;
                  if (!d) continue;
                  if (d.dataState && d.dataState !== 'idle') currentState = d.dataState;
                  else if (d.dataState === 'idle' && currentState === 'idle') currentState = 'idle';
                  if (d.monitorActive) hasMonitorOverlay = true;
                  pendingExportInFrame += (d.exportLen || 0);
                  pendingFallbackInFrame += (d.fallbackLen || 0);
                }
              } catch (_) {}
            }

            if (hasMonitorOverlay && currentState === 'idle') {
              currentState = 'generating_video';
            }

            if (currentState === 'brainstorming' || currentState === 'generating_video' || hasMonitorOverlay) {
              wasGenerating = true;
              activeGenerationTicks++;
            }

            if (currentState !== lastState) {
              lastState = currentState;
              const label = STATE_LABELS[currentState] || currentState;
              addMonitorLog(`📊 สถานะ Tool: ${label}`);

              if (currentState === 'brainstorming') {
                btn.innerHTML = '💡 Tool กำลังคิดไอเดีย...';
              } else if (currentState === 'generating_video') {
                btn.innerHTML = '🎬 Tool กำลังสร้างวิดีโอ...';
              }
            }

            // 3B. ดึงวิดีโอที่ผลิตเสร็จแล้วจาก Tool เข้าคลังวีดีโอทันทีในทุกๆ รอบ Poll (5 วินาที)
            await drainAndSaveFlowVideosToVault({ allowFallback: false });

            // 3C. ตรวจสอบเงื่อนไขจบการทำงานของ Tool:
            // - ได้รับวิดีโอครบตามจำนวนที่ตั้งไว้ (videosReceived >= expectedVideos)
            // - หรือ Tool ส่งสถานะ 'done'
            // - หรือ Tool เคยเข้าสู่โหมดผลิตแล้ว (wasGenerating) และตอนนี้กลับมาหน้าหลัก (currentState === 'idle' && !hasMonitorOverlay)
            const finishedAfterGenerating = wasGenerating && currentState === 'idle' && !hasMonitorOverlay && activeGenerationTicks >= 2;

            if (videosReceived >= expectedVideos || currentState === 'done' || finishedAfterGenerating) {
              clearInterval(pollTimer);

              addMonitorLog('⏳ Tool ผลิตเสร็จแล้ว — รอ 4 วินาทีเพื่อเก็บตกไฟล์วิดีโอล่าสุดเข้าคลัง...');
              await new Promise(r => setTimeout(r, 4000));

              // ดึงวิดีโอรอบสุดท้าย (หากยังได้ 0 คลิปเพราะ FFmpeg รวมฉากล้มเหลว ให้เปิดใช้ Scene Fallback อัตโนมัติทันที!)
              await drainAndSaveFlowVideosToVault({ allowFallback: videosReceived === 0 });

              try { await refreshVault(); } catch (_) {}

              addMonitorLog(`🎉 บันทึกวิดีโอเข้าคลังเสร็จสมบูรณ์! ได้รับวิดีโอทั้งหมด ${videosReceived} คลิป`);
              const bar = $('#monProgressBar');
              if (bar) bar.style.width = '100%';
              resolve();
              return;
            }

            // 3D. Progress log ทุก 1 นาที
            if (pollCount % 12 === 0) {
              const elapsed = Math.round(pollCount * 5 / 60);
              addMonitorLog(`⏳ ผ่านไป ${elapsed} นาที — กำลังรอ Tool ผลิตวิดีโอ... (สถานะ: ${STATE_LABELS[lastState] || lastState || 'กำลังทำงาน'}, เข้าคลังแล้ว ${videosReceived}/${expectedVideos} คลิป)`);
            }

            // 3E. Timeout (30 นาที)
            if (pollCount >= maxPollCount) {
              clearInterval(pollTimer);
              await drainAndSaveFlowVideosToVault({ allowFallback: videosReceived === 0 });
              if (videosReceived > 0) {
                addMonitorLog(`⌛ หมดเวลารอ แต่ได้รับวิดีโอ ${videosReceived} คลิปในคลัง — ดำเนินการสเต็ป 4 ต่อทันที`);
                resolve();
              } else {
                reject(new Error('หมดเวลารอ Tool ผลิตวิดีโอ (30 นาที) — กรุณาตรวจสอบ Google Flow'));
              }
              return;
            }
          } catch (pollErr) {
            console.warn('[AutoPilot v3] Poll error:', pollErr);
          }
        }, 5000); // ทุก 5 วินาที
      });

      // ═══════════ สเต็ป 4: Auto-Post / ติดตะกร้าตามที่เลือกไว้ใน Dropdown ═══════════
      const liveTargetAfterFlow = $('#factoryPostTargetSelect')?.value || factoryPostTarget || 'vault_only';
      factoryPostTarget = liveTargetAfterFlow;

      if (videosReceived > 0) {
        addMonitorLog(`📤 สเต็ป 4: ดำเนินการต่อตามเป้าหมายที่เลือกไว้ (${liveTargetAfterFlow})...`, 'POST');
        btn.innerHTML = '📤 สเต็ป 4: กำลังดำเนินการตามเป้าหมาย...';
        showToast(`📤 สเต็ป 4/4: ${liveTargetAfterFlow === 'vault_only' ? 'เก็บในคลังวีดีโอ' : 'กำลังส่งต่อและติดตะกร้าอัตโนมัติ'}...`);
        const postResult = await executeAutoPostTarget(liveTargetAfterFlow, flowBatchStartTime);
        const parts = [`เข้าคลัง ${videosReceived} คลิป`];
        if (postResult?.tiktok > 0) parts.push(`TikTok ${postResult.tiktok}`);
        if (postResult?.shopee > 0) parts.push(`Shopee ${postResult.shopee}`);
        if (postResult?.reels > 0) parts.push(`Reels ${postResult.reels}`);
        if (postResult?.cloudSync > 0) parts.push(`ส่งมือถือ ${postResult.cloudSync}`);
        if (postResult?.vaultOnly) parts.push('เก็บในคลังเรียบร้อย');
        addMonitorLog(`🏁 จบ Auto-Pilot (Google Flow): ${parts.join(' | ')}`, 'SUCCESS');
        showToast(`🎉 สำเร็จ! ${parts.join(' | ')}`, 6000);
        const monBar = $('#monProgressBar');
        if (monBar) monBar.style.width = '100%';
        setMonitorCompletedState(videosReceived);
      } else {
        addMonitorLog('ℹ️ ไม่มีวิดีโอใหม่สำหรับดำเนินการต่อ');
        showToast('ℹ️ ไม่มีวิดีโอใหม่', 4000);
        if (isFactoryAborted) {
          setMonitorAbortedState();
        } else {
          setMonitorCompletedState(0);
        }
      }

    } catch (err) {
      console.error('[OneClickAutoPilot v3] Error:', err);
      addMonitorLog(`❌ เกิดข้อผิดพลาด: ${err.message}`);
      showToast(`❌ ${err.message}`);
      if (isFactoryAborted) setMonitorAbortedState();
    } finally {
      isFactoryBusy = false;
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  });

  /* ═══════════════════════════════════════════════════════════════════════
     FACTORY — Start Production (Manual button)
     ═══════════════════════════════════════════════════════════════════════ */
  $('#btnStartFactory')?.addEventListener('click', async () => {
    const selectedIdeas = factoryIdeas.filter(i => i._selected);
    if (selectedIdeas.length === 0) {
      showToast('กรุณาเลือกอย่างน้อย 1 ไอเดียจาก Idea Bank');
      return;
    }
    if (factoryProducts.length === 0) {
      showToast('กรุณาเพิ่มสินค้าก่อนเริ่มผลิต');
      return;
    }

    // Check if scripts are generated for selected ideas
    const selectedScripts = {};
    let hasMissing = false;
    selectedIdeas.forEach((idea, idx) => {
      const realIdx = factoryIdeas.indexOf(idea);
      if (!factoryScripts[realIdx]) {
        hasMissing = true;
      } else {
        selectedScripts[idx] = factoryScripts[realIdx];
      }
    });

    if (hasMissing) {
      showToast('กรุณากด "ดูบท" เพื่อสร้างบทให้ครบก่อน');
      return;
    }

    // Show monitor
    const monitor = $('#factoryMonitor');
    if (monitor) monitor.classList.remove('hidden');
    const logEl = $('#monLog');
    if (logEl) logEl.innerHTML = '';
    setMonitorRunningState();

    const btn = $('#btnStartFactory');
    btn.disabled = true;
    btn.innerHTML = '⏳ กำลังผลิต...';

    // Log the production plan
    addMonitorLog(`📋 แผนผลิต: ${factoryProducts.length} สินค้า × ${selectedIdeas.length} ไอเดีย`);
    factoryProducts.forEach((p, i) => addMonitorLog(`   สินค้า ${i + 1}: ${p.name}`));
    selectedIdeas.forEach((idea, i) => addMonitorLog(`   ไอเดีย ${i + 1}: ${idea.headline}`));

    // Listen for progress from background
    const progressHandler = (msg) => {
      if (msg?.type === 'PHIMBOT_FACTORY_STATUS') {
        const p = msg.payload;
        addMonitorLog(p.message || p.step || '');
        
        // Update progress counters
        if (p.productIdx !== undefined) {
          const mp = $('#monProduct');
          const mi = $('#monIdea');
          if (mp) mp.textContent = `${p.productIdx + 1}/${p.productTotal || factoryProducts.length}`;
          if (mi) mi.textContent = `${p.ideaIdx + 1}/${p.ideaTotal || selectedIdeas.length}`;
        }
        if (p.sceneIdx !== undefined) {
          const ms = $('#monScene');
          if (ms) ms.textContent = `${p.sceneIdx + 1}/${$('#factorySceneCount')?.value || 3}`;
        }

        // Update progress bar
        if (p.productTotal && p.ideaTotal) {
          const total = p.productTotal * p.ideaTotal;
          const current = p.productIdx * p.ideaTotal + (p.ideaIdx || 0);
          const pct = Math.round((current / total) * 100);
          const bar = $('#monProgressBar');
          if (bar) bar.style.width = `${pct}%`;
        }

        // Done
        if (p.status === 'done') {
          addMonitorLog('🎉 ผลิตเสร็จสมบูรณ์! ไปดูวีดีโอในแท็บ "คลัง"');
          const bar = $('#monProgressBar');
          if (bar) bar.style.width = '100%';
          btn.disabled = false;
          btn.innerHTML = '🚀 ขั้นตอน 2: เดินเครื่องผลิต + โพสต์';
          setMonitorCompletedState(p.count || 0);
          chrome.runtime.onMessage.removeListener(progressHandler);

          // Auto-sync to mobile Shopee if enabled
          const autoSync = $('#factoryAutoSyncShopee')?.checked;
          if (autoSync && window.ASUClipSync) {
            (async () => {
              try {
                const s = await window.ASUClipSync.getClipSyncSettings();
                if (s.enabled && s.pairCode) {
                  addMonitorLog('☁️ กำลังส่งคลิปที่ผลิตเสร็จเข้ามือถืออัตโนมัติ...');
                  const vaultRes = await sendMsg('PHIMBOT_VAULT_GET');
                  const vaultList = vaultRes.vault || [];
                  const unpostedShopee = vaultList.filter(v => !v.posted?.shopee && v.videoBase64);
                  let sentCount = 0;
                  for (const vid of unpostedShopee.slice(0, 5)) {
                    let pUrl = vid.productUrl || '';
                    if (!pUrl) {
                      const pFound = factoryProducts.find(prod => (prod.productId || prod.id) === vid.productId);
                      if (pFound) pUrl = window.ASUClipSync.resolveClipSyncProductUrl(pFound);
                    }
                    const res = await window.ASUClipSync.pushClipToRelay(vid.videoBase64, {
                      sourceMode: 'factory_auto',
                      productTitle: vid.productName || vid.headline || '',
                      productUrl: pUrl,
                      caption: vid.headline || vid.productName || '',
                      hashtags: '#ShopeeTH #ShopeeVideo #รีวิว #ของดีบอกต่อ'
                    });
                    if (res && res.success) {
                      await sendMsg('PHIMBOT_VAULT_MARK_POSTED', { id: vid.id, platform: 'shopee' });
                      sentCount++;
                    }
                  }
                  if (sentCount > 0) {
                    addMonitorLog(`📲 ส่งคลิปเข้ามือถือ Shopee แล้ว ${sentCount} คลิป!`);
                    showToast(`📲 ส่งเข้ามือถือเรียบร้อย ${sentCount} คลิป`);
                  }
                }
              } catch (e) {
                console.warn('[VideoFactory] Auto sync mobile error:', e);
              }
            })();
          }
        }
        if (p.status === 'error' && !p.message?.includes('ฉาก')) {
          btn.disabled = false;
          btn.innerHTML = '🚀 ขั้นตอน 2: เดินเครื่องผลิต + โพสต์';
          chrome.runtime.onMessage.removeListener(progressHandler);
        }
      }
    };
    chrome.runtime.onMessage.addListener(progressHandler);

    // Send to background to start the factory
    addMonitorLog('🚀 กำลังเปิด Google Flow...');
    const res = await sendMsg('PHIMBOT_START_VIDEO_FACTORY', {
      products: factoryProducts,
      ideas: selectedIdeas.map(i => ({ headline: i.headline, concept: i.concept })),
      scripts: selectedScripts,
      charImages: factoryCharImages,  // รูปตัวละคร Reference (base64)
      imageModel: $('#factoryImageModel')?.value || '🍌 Nano Banana Pro',
      videoModel: $('#factoryVideoModel')?.value || 'Veo 3.1 - Lite [Lower Priority]',
      duration: parseInt($('#factoryDuration')?.value || '8'),
      mode: factoryMode
    });

    if (!res.success) {
      addMonitorLog(`❌ เกิดข้อผิดพลาด: ${res.error}`);
      btn.disabled = false;
      btn.innerHTML = '🚀 ขั้นตอน 2: เดินเครื่องผลิต + โพสต์';
      chrome.runtime.onMessage.removeListener(progressHandler);
    }
  });

  const monitorLogHistory = [];

  function addMonitorLog(text, level = 'INFO') {
    const time = new Date().toLocaleTimeString('th');
    const entry = { time, text, level };
    monitorLogHistory.push(entry);
    console.log(`[Factory ${level}] ${text}`);

    const log = $('#monLog');
    if (!log) return;

    const LEVEL_COLORS = {
      INFO: '#94a3b8',   // slate
      POST: '#38bdf8',   // sky blue
      ERROR: '#f87171',  // red
      SUCCESS: '#4ade80', // green
    };

    const line = document.createElement('div');
    line.style.cssText = `margin-bottom:3px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.04);color:${LEVEL_COLORS[level] || LEVEL_COLORS.INFO};`;
    const levelBadge = level !== 'INFO' ? `[${level}] ` : '';
    line.textContent = `[${time}] ${levelBadge}${text}`;
    log.appendChild(line);
    log.scrollTop = log.scrollHeight;
  }

  /* ═══════════════════════════════════════════════════════════════════════
