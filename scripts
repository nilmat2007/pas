/**
 * PhimBot — Video Factory & Media Vault Logic
 * Handles AI brainstorming, script writing, Google Flow login, and Media Vault
 */
(function () {
  'use strict';

  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => document.querySelectorAll(sel);
  function sendMsg(type, payload) { return new Promise((r) => chrome.runtime.sendMessage({ type, payload }, (res) => r(res || {}))); }
  function showToast(msg, dur = 3000) { const t = $('#toast'); t.textContent = msg; t.classList.remove('hidden'); setTimeout(() => t.classList.add('hidden'), dur); }

  /* ═══════════════════════════════════════════════════════════════════════
     STATE
     ═══════════════════════════════════════════════════════════════════════ */
  let factoryProducts = [];          // สินค้าที่อยู่ในคิวผลิต
  let factoryCharImages = [];        // รูปตัวละคร Reference (base64)
  window.__phimbotFactoryProducts = factoryProducts;
  window.__phimbotFactoryCharImages = factoryCharImages;
  let factoryIdeas = [];             // ไอเดียที่ AI คิดได้
  let factoryScripts = {};           // บทต่อไอเดีย { ideaIdx: scenes[] }
  let factoryMode = 'influencer';    // 'influencer' | 'hands'
  let factoryVoice = 'female';       // 'female' | 'male'
  let isFactoryBusy = false;
  let isFactoryAborted = false;

  /* ═══════════════════════════════════════════════════════════════════════
     INIT — Tab switching hook
     ═══════════════════════════════════════════════════════════════════════ */
  // Hook into existing tab switching — refresh vault/factory when switching to those tabs
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    if (btn.dataset.tab === 'vault') refreshVault();
    if (btn.dataset.tab === 'factory') checkFlowLogin();
  });

  /* ═══════════════════════════════════════════════════════════════════════
     GOOGLE FLOW LOGIN
     ═══════════════════════════════════════════════════════════════════════ */
  async function checkFlowLogin() {
    const dot = $('#flowStatusDot');
    const txt = $('#flowStatusText');
    if (!dot || !txt) return;
    const res = await sendMsg('PHIMBOT_CHECK_FLOW_LOGIN');
    if (res.loggedIn) {
      dot.style.background = '#22c55e';
      txt.textContent = 'Google Flow: พร้อมใช้งาน ✓';
    } else {
      dot.style.background = '#ef4444';
      txt.textContent = 'Google Flow: ยังไม่ได้ล็อกอิน';
    }
  }

  $('#btnLoginFlow')?.addEventListener('click', async () => {
    await sendMsg('PHIMBOT_OPEN_FLOW_LOGIN');
    showToast('กำลังเปิด Google Flow — กรุณาล็อกอิน Google Account');
    // Re-check after a delay
    setTimeout(() => checkFlowLogin(), 5000);
  });

  /* ═══════════════════════════════════════════════════════════════════════
     ENGINE SELECTOR — สลับ Meta AI / Google Flow UI
     ═══════════════════════════════════════════════════════════════════════ */
  $('#factoryVideoEngine')?.addEventListener('change', (e) => {
    const engine = e.target.value;
    const metaBox = $('#metaAiPromptBox');
    // Model Settings section ที่มี #factoryImageModel คือ section ถัดจาก engine selector
    const modelSection = $('#factoryImageModel')?.closest('section.card');
    // ปุ่ม Flow-specific: Clear Flow Queue, Start ใน Tool, Tool Brainstorm
    const flowBtns = [
      $('#btnFactoryClearFlowQueue'),
      $('#btnTriggerFlowStartFactory'),
      $('#btnTriggerFlowBrainstorm')
    ];

    if (engine === 'meta_ai') {
      if (metaBox) metaBox.classList.remove('hidden');
      if (modelSection) modelSection.style.display = 'none';
      flowBtns.forEach(b => { if (b) b.style.display = 'none'; });
    } else {
      if (metaBox) metaBox.classList.add('hidden');
      if (modelSection) modelSection.style.display = '';
      flowBtns.forEach(b => { if (b) b.style.display = ''; });
    }
  });

  $('#btnClearFlowCache')?.addEventListener('click', async () => {
    const btn = $('#btnClearFlowCache');
    if (!btn) return;
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.innerHTML = '⏳ กำลังล้าง...';
    showToast('🧹 กำลังล้างแคช Google Flow...');
    try {
      const res = await sendMsg('PHIMBOT_CLEAR_FLOW_SITE_DATA');
      if (res?.ok || res?.success) {
        showToast('✅ ล้างแคช Google Flow สำเร็จ!');
        if (typeof addMonitorLog === 'function') {
          addMonitorLog('🧹 ล้างแคช IndexedDB และ Service Worker ของ Google Flow เรียบร้อย');
        }
        await checkFlowLogin();
      } else {
        const err = res?.error || res?.reason || 'เกิดข้อผิดพลาด';
        showToast(`❌ ล้างแคชไม่สำเร็จ: ${err}`);
      }
    } catch (e) {
      showToast(`❌ ล้างแคชผิดพลาด: ${e.message}`);
    } finally {
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  });

  /* ═══════════════════════════════════════════════════════════════════════
     FACTORY — Product Queue
     ═══════════════════════════════════════════════════════════════════════ */
  function renderFactoryProducts() {
    const container = $('#factoryProductQueue');
    if (!container) return;
    container.innerHTML = '';
    if (factoryProducts.length === 0) {
      container.innerHTML = '<div style="color:var(--text-dim);font-size:11px;padding:8px;">ยังไม่มีสินค้า — กดปุ่มด้านล่างเพื่อเพิ่ม</div>';
      return;
    }
    factoryProducts.forEach((p, idx) => {
      const chip = document.createElement('div');
      chip.style.cssText = 'display:flex;align-items:center;gap:4px;background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:4px 10px 4px 4px;font-size:11px;';
      const imgSrc = p.images?.[0] || p.imageUrl || '';
      if (imgSrc) {
        const img = document.createElement('img');
        img.src = imgSrc;
        img.style.cssText = 'width:24px;height:24px;border-radius:50%;object-fit:cover;';
        chip.appendChild(img);
      }
      const name = document.createElement('span');
      name.textContent = p.name?.substring(0, 20) || 'สินค้า';
      name.style.cssText = 'max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
      chip.appendChild(name);
      const del = document.createElement('span');
      del.textContent = '✕';
      del.style.cssText = 'cursor:pointer;color:var(--text-dim);margin-left:4px;font-size:10px;';
      del.onclick = () => { factoryProducts.splice(idx, 1); renderFactoryProducts(); };
      chip.appendChild(del);
      container.appendChild(chip);
    });
  }

  $('#btnAddFactoryProduct')?.addEventListener('click', async () => {
    const source = $('#factoryProductSource')?.value || 'tiktok';
    let products = [];

    if (source === 'shopee') {
      // ดึงสินค้า Shopee ผ่าน background (รวมผลสแกน + ประวัติ)
      const res = await sendMsg('PHIMBOT_GET_SHOPEE_PRODUCTS');
      products = res.products || [];
      console.log('[Factory] Shopee products:', products.length, 'items');
    } else {
      // ดึงสินค้า TikTok
      const res = await sendMsg('PHIMBOT_GET_PRODUCTS');
      products = (res.products || []).map(p => ({ ...p, platform: 'tiktok' }));
    }

    if (products.length === 0) {
      const tabName = source === 'shopee' ? 'Shopee' : 'TikTok';
      showToast(`ยังไม่มีสินค้า${tabName}ในคลัง — ไปแท็บ "${tabName}" เพื่อดึงสินค้าก่อน`);
      return;
    }
    showFactoryProductPicker(products, source);
  });

  function showFactoryProductPicker(products, source = 'tiktok') {
    // Create a lightweight modal
    let modal = $('#factoryProductModal');
    if (modal) modal.remove();

    const platformIcon = source === 'shopee' ? '🛒' : '🎵';
    const platformName = source === 'shopee' ? 'Shopee' : 'TikTok';

    modal = document.createElement('div');
    modal.id = 'factoryProductModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;';

    const box = document.createElement('div');
    box.style.cssText = 'background:var(--bg-panel);border-radius:16px;max-height:80vh;width:100%;max-width:400px;overflow:hidden;display:flex;flex-direction:column;';

    // Header
    box.innerHTML = `<div style="padding:16px;border-bottom:1.5px solid var(--border);">
      <h3 style="margin:0;font-size:14px;font-weight:700;">${platformIcon} เลือกสินค้า ${platformName} สำหรับผลิตวีดีโอ</h3>
      <input id="factoryPickerSearch" style="width:100%;margin-top:8px;padding:8px;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-primary);font-size:12px;" placeholder="🔍 ค้นหาชื่อสินค้า...">
      <div style="display:flex;gap:6px;margin-top:8px;">
        <button id="factoryPickerAddAll" class="btn btn-secondary btn-sm" type="button" style="flex:1;font-size:11px;padding:5px 8px;">+ ทั้งหมด (<span id="factoryPickerUnaddedCount">0</span>)</button>
        <button id="factoryPickerAdd5" class="btn btn-secondary btn-sm" type="button" style="font-size:11px;padding:5px 8px;">+ 5 ชิ้น</button>
        <button id="factoryPickerAdd10" class="btn btn-secondary btn-sm" type="button" style="font-size:11px;padding:5px 8px;">+ 10 ชิ้น</button>
      </div>
    </div>`;

    // Product list
    const list = document.createElement('div');
    list.style.cssText = 'overflow-y:auto;flex:1;padding:8px;';

    const existingIds = new Set(factoryProducts.map(p => p.productId || p.id));

    const renderList = (filter = '') => {
      list.innerHTML = '';
      const filtered = filter ? products.filter(p => (p.name || '').toLowerCase().includes(filter.toLowerCase())) : products;
      const unaddedCount = filtered.filter(p => !existingIds.has(p.productId || p.id)).length;
      const countEl = modal.querySelector('#factoryPickerUnaddedCount');
      if (countEl) countEl.textContent = unaddedCount;

      filtered.forEach(p => {
        const isAdded = existingIds.has(p.productId || p.id);
        const row = document.createElement('div');
        row.style.cssText = `display:flex;align-items:center;gap:8px;padding:8px;border-radius:12px;cursor:${isAdded ? 'default' : 'pointer'};opacity:${isAdded ? '0.4' : '1'};margin-bottom:6px;background:var(--bg-card);border:1.5px solid var(--border);`;
        row.innerHTML = `
          ${(p.images?.[0] || p.imageUrl) ? `<img src="${p.images?.[0] || p.imageUrl}" style="width:40px;height:40px;border-radius:8px;object-fit:cover;">` : '<div style="width:40px;height:40px;border-radius:8px;background:var(--border);"></div>'}
          <div style="flex:1;overflow:hidden;">
            <div style="font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-primary);">${p.name || 'ไม่มีชื่อ'}</div>
            <div style="font-size:10px;color:var(--text-muted);">${p.price || ''}</div>
          </div>
          ${isAdded ? '<span style="font-size:10px;font-weight:600;color:var(--text-muted);">เพิ่มแล้ว</span>' : '<span style="font-size:16px;font-weight:700;color:var(--accent);">+</span>'}
        `;
        if (!isAdded) {
          row.onclick = () => {
            factoryProducts.push(p);
            existingIds.add(p.productId || p.id);
            renderFactoryProducts();
            renderList(document.getElementById('factoryPickerSearch')?.value || '');
            showToast(`เพิ่ม "${(p.name || '').substring(0, 20)}" เข้าคิวผลิต`);
          };
        }
        list.appendChild(row);
      });
    };

    const addBatch = (limit = 999) => {
      const currentFilter = document.getElementById('factoryPickerSearch')?.value || '';
      const filtered = currentFilter ? products.filter(p => (p.name || '').toLowerCase().includes(currentFilter.toLowerCase())) : products;
      const unadded = filtered.filter(p => !existingIds.has(p.productId || p.id)).slice(0, limit);
      if (unadded.length === 0) {
        showToast('สินค้าที่เลือกถูกเพิ่มเข้าคิวหมดแล้ว');
        return;
      }
      unadded.forEach(p => {
        factoryProducts.push(p);
        existingIds.add(p.productId || p.id);
      });
      renderFactoryProducts();
      renderList(currentFilter);
      showToast(`🎉 เพิ่มสินค้า ${unadded.length} รายการเข้าคิวผลิตเรียบร้อย!`);
    };

    renderList();
    box.appendChild(list);

    // Footer
    const footer = document.createElement('div');
    footer.style.cssText = 'padding:12px;border-top:1.5px solid var(--border);text-align:center;';
    footer.innerHTML = '<button id="factoryPickerClose" class="btn btn-outline" style="width:100%;">ปิด</button>';
    box.appendChild(footer);

    modal.appendChild(box);
    document.body.appendChild(modal);

    // Events
    modal.querySelector('#factoryPickerSearch')?.addEventListener('input', (e) => renderList(e.target.value));
    modal.querySelector('#factoryPickerAddAll')?.addEventListener('click', () => addBatch(999));
    modal.querySelector('#factoryPickerAdd5')?.addEventListener('click', () => addBatch(5));
    modal.querySelector('#factoryPickerAdd10')?.addEventListener('click', () => addBatch(10));
    modal.querySelector('#factoryPickerClose')?.addEventListener('click', () => modal.remove());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
  }

  /* ═══════════════════════════════════════════════════════════════════════
     FACTORY — Mode & Gender Switching (Synced + Persisted + Auto-Detect)
     ═══════════════════════════════════════════════════════════════════════ */
  let userManuallySelectedGender = false;

  function setFactoryGenderUI(gender, saveStorage = true, syncFlow = true) {
    const g = gender === 'male' ? 'male' : 'female';
    factoryVoice = g;
    window.__phimbotFactoryVoice = g;
    $$('.factory-voice-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.voice === g);
    });
    const metaGenderEl = $('#metaAiCharGender');
    if (metaGenderEl && metaGenderEl.value !== g) {
      metaGenderEl.value = g;
    }
    if (saveStorage) {
      try { chrome.storage.local.set({ phimbot_factory_voice_gender: g }); } catch (_) {}
    }
    if (syncFlow) {
      sendMsg('PHIMBOT_SET_FLOW_GENDER', { gender: g }).catch(() => {});
    }
  }

  // Restore saved gender preference on init
  try {
    chrome.storage.local.get(['phimbot_factory_voice_gender'], (res) => {
      if (res?.phimbot_factory_voice_gender) {
        setFactoryGenderUI(res.phimbot_factory_voice_gender, false, false);
      }
    });
  } catch (_) {}

  $$('.factory-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      $$('.factory-mode-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      factoryMode = btn.dataset.mode;
      const charSection = $('#factoryCharSection');
      const voiceSection = $('#factoryVoiceSection');
      // Always keep voice/gender section visible in BOTH influencer and hands modes
      voiceSection?.classList.remove('hidden');
      if (factoryMode === 'influencer') {
        charSection?.classList.remove('hidden');
        const infOpts = $('#metaAiInfluencerOpts');
        if (infOpts) infOpts.style.display = '';
      } else {
        charSection?.classList.add('hidden');
        const infOpts = $('#metaAiInfluencerOpts');
        if (infOpts) infOpts.style.display = 'none';
      }
    });
  });

  $$('.factory-voice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      userManuallySelectedGender = true;
      setFactoryGenderUI(btn.dataset.voice, true, true);
      const label = btn.dataset.voice === 'male' ? '👨 ชาย (ครับ)' : '👩 หญิง (ค่ะ)';
      showToast(`ตั้งค่าเพศตัวละคร/เสียงพากย์: ${label}`);
    });
  });

  $('#metaAiCharGender')?.addEventListener('change', (e) => {
    userManuallySelectedGender = true;
    setFactoryGenderUI(e.target.value, true, true);
  });

  /* ═══════════════════════════════════════════════════════════════════════
     FACTORY — Character Upload + Auto Gender Detection
     ═══════════════════════════════════════════════════════════════════════ */
  function renderCharGrid() {
    const grid = $('#factoryCharGrid');
    if (!grid) return;
    grid.innerHTML = '';
    factoryCharImages.forEach((src, idx) => {
      const wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative;border-radius:10px;overflow:hidden;aspect-ratio:1;background:var(--bg-card);border:2px solid var(--accent);';
      const img = document.createElement('img');
      img.src = src;
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
      wrap.appendChild(img);
      const del = document.createElement('div');
      del.textContent = '✕';
      del.style.cssText = 'position:absolute;top:2px;right:4px;background:rgba(0,0,0,0.6);color:white;width:16px;height:16px;border-radius:50%;font-size:9px;display:flex;align-items:center;justify-content:center;cursor:pointer;';
      del.onclick = () => { factoryCharImages.splice(idx, 1); renderCharGrid(); };
      wrap.appendChild(del);
      grid.appendChild(wrap);
    });
  }

  $('#btnAddChar')?.addEventListener('click', () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.multiple = true;
    input.onchange = async () => {
      for (const file of input.files) {
        const base64 = await fileToBase64(file);
        factoryCharImages.push(base64);
      }
      renderCharGrid();
      showToast(`📷 เพิ่มรูปตัวละคร ${input.files.length} รูป — กำลังวิเคราะห์เพศอัตโนมัติ...`);
      if (factoryCharImages[0]) {
        try {
          const det = await sendMsg('PHIMBOT_DETECT_CHARACTER_GENDER', { dataUrl: factoryCharImages[0] });
          if (det?.ok && det.gender) {
            window.__lastAnalyzedCharImg = factoryCharImages[0];
            window.__lastAnalyzedCharGender = det.gender;
            setFactoryGenderUI(det.gender, true, true);
            showToast(det.gender === 'male'
              ? '👨 ตรวจพบรูปผู้ชาย — ตั้งค่าเป็น "ชาย (ครับ)" อัตโนมัติ!'
              : '👩 ตรวจพบรูปผู้หญิง — ตั้งค่าเป็น "หญิง (ค่ะ)" อัตโนมัติ!', 4000);
          }
        } catch (_) {}
      }
    };
    input.click();
  });

  function fileToBase64(file) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.readAsDataURL(file);
    });
  }

  /* ═══════════════════════════════════════════════════════════════════════
     FACTORY — AI Brainstorm Ideas
     ═══════════════════════════════════════════════════════════════════════ */
  $('#btnBrainstorm')?.addEventListener('click', async () => {
    if (factoryProducts.length === 0) {
      showToast('กรุณาเพิ่มสินค้าก่อนคิดไอเดีย');
      return;
    }
    if (isFactoryBusy) return;
    isFactoryBusy = true;

    const btn = $('#btnBrainstorm');
    const ideaBank = $('#ideaBank');
    const ideaCount = parseInt($('#factoryIdeaCount')?.value || '1', 10);
    const product = factoryProducts[0]; // ใช้สินค้าแรกในคิวเป็น Reference

    btn.disabled = true;
    btn.innerHTML = '⏳ กำลังคิดไอเดีย...';

    const res = await sendMsg('PHIMBOT_BRAINSTORM_ADS', {
      productName: product.name || '',
      keywords: product.keywords || product.description || '',
      mode: factoryMode,
      ideaCount
    });

    btn.disabled = false;
    btn.innerHTML = '💡 ขั้นตอน 1: คิดไอเดียโฆษณา';
    isFactoryBusy = false;

    if (res.success && res.ideas) {
      factoryIdeas = res.ideas;
      renderIdeaBank();
      showToast(`คิดไอเดียได้ ${res.ideas.length} รูปแบบ!`);
    } else if (res.parseError) {
      showToast('AI ตอบกลับแต่ parse ไม่ได้ — ลองใหม่');
    } else {
      showToast(res.error || 'เกิดข้อผิดพลาด');
    }
  });

  function renderIdeaBank() {
    const bank = $('#ideaBank');
    if (!bank) return;
    bank.classList.remove('hidden');
    bank.innerHTML = '<h4 style="font-size:12px;font-weight:700;margin-bottom:8px;color:var(--accent);">💡 Idea Bank</h4>';

    factoryIdeas.forEach((idea, idx) => {
      const card = document.createElement('div');
      card.style.cssText = 'background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:8px;cursor:pointer;transition:border-color 0.2s;';
      card.dataset.ideaIdx = idx;

      const isSelected = idea._selected;
      if (isSelected) card.style.borderColor = 'var(--accent)';

      card.innerHTML = `
        <div style="display:flex;align-items:flex-start;gap:8px;">
          <input type="checkbox" ${isSelected ? 'checked' : ''} style="margin-top:2px;accent-color:var(--accent);" class="idea-check" data-idx="${idx}">
          <div style="flex:1;">
            <div style="font-size:12px;font-weight:700;margin-bottom:4px;">${idea.headline || 'ไม่มี Headline'}</div>
            <div style="font-size:11px;color:var(--text-dim);">${idea.concept || ''}</div>
          </div>
          <button class="btn-idea-script" data-idx="${idx}" style="font-size:10px;padding:4px 8px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);cursor:pointer;flex-shrink:0;">📝 ดูบท</button>
        </div>
        <div id="ideaScriptArea_${idx}" class="hidden" style="margin-top:8px;border-top:1px solid var(--border);padding-top:8px;"></div>
      `;

      bank.appendChild(card);
    });

    // Event: checkbox toggle
    bank.querySelectorAll('.idea-check').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.idx);
        factoryIdeas[idx]._selected = e.target.checked;
        renderIdeaBank();
      });
    });

    // Event: script button
    bank.querySelectorAll('.btn-idea-script').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.dataset.idx);
        await loadScript(idx);
      });
    });

    // Summary
    const selectedCount = factoryIdeas.filter(i => i._selected).length;
    const summary = document.createElement('div');
    summary.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding:8px;background:var(--bg-deep);border-radius:8px;font-size:11px;';
    summary.innerHTML = `
      <span>เลือกแล้ว <strong>${selectedCount}</strong> ไอเดีย</span>
      <div style="display:flex;gap:6px;">
