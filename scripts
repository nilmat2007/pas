  // Sync / Import Videos from Google Flow Tool into Vault (Two-Tier Direct Storage)
  $('#btnSyncFlowVideos')?.addEventListener('click', async () => {
    const btn = $('#btnSyncFlowVideos');
    btn.disabled = true;
    btn.textContent = '⏳ กำลังสแกน...';
    try {
      const allTabs = await chrome.tabs.query({});
      const flowTabs = allTabs.filter(t => t.url && (t.url.includes('flow.google.com') || t.url.includes('labs.google')));
      if (!flowTabs.length) {
        showToast('⚠️ ไม่พบแท็บ Google Flow ที่เปิดอยู่ — กรุณาเปิด Google Flow ก่อน');
        btn.disabled = false;
        btn.textContent = '📥 ดึงคลิปจาก Flow Tool';
        return;
      }

      let importedCount = 0;
      for (const tab of flowTabs) {
        const results = await chrome.scripting.executeScript({
          target: { tabId: tab.id, allFrames: true },
          world: 'MAIN',
          func: async () => {
            const list = [];
            if (Array.isArray(window.__FLOW_EXPORT_VIDEOS__) && window.__FLOW_EXPORT_VIDEOS__.length > 0) {
              list.push(...window.__FLOW_EXPORT_VIDEOS__.splice(0, window.__FLOW_EXPORT_VIDEOS__.length));
            }
            if (Array.isArray(window.__FLOW_SCENE_FALLBACK_VIDEOS__) && window.__FLOW_SCENE_FALLBACK_VIDEOS__.length > 0 && list.length === 0) {
              list.push(...window.__FLOW_SCENE_FALLBACK_VIDEOS__.splice(0, window.__FLOW_SCENE_FALLBACK_VIDEOS__.length));
            }
            if (Array.isArray(window.__FLOW_TOOL_VIDEOS__) && window.__FLOW_TOOL_VIDEOS__.length > 0) {
              list.push(...window.__FLOW_TOOL_VIDEOS__.splice(0, window.__FLOW_TOOL_VIDEOS__.length));
            }
            // ดึงจาก <video src="blob:..."> ในหน้า Tool หากคิวว่าง
            if (list.length === 0 && location.href.includes('scf.usercontent.goog')) {
              const videoEls = Array.from(document.querySelectorAll('video'));
              for (const v of videoEls) {
                const src = v.currentSrc || v.src || '';
                if (src.startsWith('blob:')) {
                  try {
                    const resp = await fetch(src);
                    const blob = await resp.blob();
                    if (blob.size > 45000 && blob.type.startsWith('video/')) {
                      const b64 = await new Promise((res) => {
                        const r = new FileReader();
                        r.__phimbotInternal = true;
                        r.onload = () => res(r.result);
                        r.onerror = () => res('');
                        r.readAsDataURL(blob);
                      });
                      if (b64) {
                        const domPid = String(document.getElementById('tiktok-product-id')?.value || '').replace(/^PID_/i, '').trim();
                        const domName = String(document.getElementById('active-product-name')?.value || '').trim();
                        list.push({
                          productId: domPid,
                          productName: domName || 'สินค้าจาก AI SALER PRO',
                          headline: (domName || 'คลิปจาก Google Flow') + ' รีวิวของดีบอกต่อ',
                          videoBase64: b64,
                          videoUrl: src,
                          platform: 'tiktok'
                        });
                      }
                    }
                  } catch (_) {}
                }
              }
            }
            return list;
          }
        });

        if (results && results.length) {
          for (const r of results) {
            const items = r.result || [];
            for (const item of items) {
              let vb64 = item.videoBase64 || item.dataUrl || '';
              if (!vb64) continue;
              if (vb64.startsWith('data:application/octet-stream')) {
                vb64 = vb64.replace('data:application/octet-stream', 'data:video/mp4');
              } else if (!vb64.startsWith('data:')) {
                vb64 = 'data:video/mp4;base64,' + vb64;
              }
              if (vb64.length < 60000) continue;

              const itemId = `vid_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`;
              const videoKey = `phimbot_video_${itemId}`;
              await chrome.storage.local.set({ [videoKey]: vb64 });

              const storeNow = await chrome.storage.local.get(['phimbot_media_vault']);
              const vault = storeNow.phimbot_media_vault || [];
              const fallbackProd = (typeof factoryProducts !== 'undefined' && factoryProducts[0]) ? factoryProducts[0] : {};
              const cleanPid = String(item.productId || item.tiktokProductId || fallbackProd.productId || fallbackProd.id || '').replace(/^PID_/i, '').trim();
              const cleanName = item.productName || item.title || fallbackProd.name || 'สินค้า Google Flow';
              const cleanUrl = item.productUrl || item.affiliateUrl || fallbackProd.affiliateUrl || fallbackProd.productUrl || '';
              const flowHashtags = resolveProductHashtags({ ...item, productId: cleanPid, productName: cleanName });
              const pImg = resolveProductImage({ ...item, productId: cleanPid, productName: cleanName });
              const vThumb = item.thumbnail || await generateVideoThumbnail(vb64);

              vault.unshift({
                id: itemId,
                productId: cleanPid,
                productName: cleanName,
                productUrl: cleanUrl,
                headline: item.headline || `${cleanName} รีวิวของดีบอกต่อ`,
                videoBase64: '',
                videoStorageKey: videoKey,
                videoBase64Size: vb64.length,
                videoUrl: item.videoUrl || '',
                thumbnail: vThumb,
                productImage: pImg,
                caption: item.caption || `${cleanName} รีวิวของดีบอกต่อ`,
                hashtags: flowHashtags,
                platform: item.platform || (cleanUrl.includes('shopee') ? 'shopee' : 'tiktok'),
                source: 'manual_sync',
                createdAt: new Date().toISOString(),
                posted: { tiktok: false, reels: false, shopee: false }
              });
              await chrome.storage.local.set({ phimbot_media_vault: vault });
              importedCount++;
            }
          }
        }
      }

      if (importedCount > 0) {
        showToast(`🎉 ดึงคลิปเข้าคลังสำเร็จ ${importedCount} รายการ!`);
        refreshVault();
      } else {
        showToast('ℹ️ ไม่พบคลิปใหม่ใน Google Flow');
      }
    } catch (e) {
      console.warn('[VaultSync] Error:', e);
      showToast('⚠️ ดึงคลิปล้มเหลว: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.textContent = '📥 ดึงคลิปจาก Flow Tool';
    }
  });

