  function updateVaultBatchBarUI(filteredList) {
    const list = filteredList || (currentVaultList || []);
    const countEl = $('#vaultSelectedCount');
    const toggleAll = $('#vaultSelectAllToggle');
    const batchScheduleBtn = $('#btnVaultBatchSchedule');

    // Clean up selectedVaultIds that no longer exist in currentVaultList
    const validIds = new Set((currentVaultList || []).map(v => v.id));
    for (const id of Array.from(selectedVaultIds)) {
      if (!validIds.has(id)) selectedVaultIds.delete(id);
    }

    const count = selectedVaultIds.size;
    if (countEl) countEl.textContent = count;
    if (batchScheduleBtn) {
      batchScheduleBtn.disabled = count === 0;
      batchScheduleBtn.innerHTML = `⏰ ตั้งเวลาโพสต์ TikTok ที่เลือก (${count})`;
    }

    if (toggleAll) {
      const visibleIds = (list.length > 0 ? list : (currentVaultList || [])).map(v => v.id);
      const allVisibleSelected = visibleIds.length > 0 && visibleIds.every(id => selectedVaultIds.has(id));
      const someVisibleSelected = visibleIds.some(id => selectedVaultIds.has(id));
      toggleAll.checked = allVisibleSelected;
      toggleAll.indeterminate = !allVisibleSelected && someVisibleSelected;
    }
  }

  function formatTimelineDate(d) {
    const thaiMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
    const day = d.getDate();
    const month = thaiMonths[d.getMonth()];
    const hours = String(d.getHours()).padStart(2, '0');
    const mins = String(d.getMinutes()).padStart(2, '0');
    return `${day} ${month} เวลา ${hours}:${mins} น.`;
  }

  function renderBatchTimelinePreview() {
    const listContainer = $('#vBatchTimelineList');
    const summaryEl = $('#vBatchTimelineSummary');
    if (!listContainer) return;

    const selectedList = (currentVaultList || []).filter(v => selectedVaultIds.has(v.id));
    const publishMode = $('#vBatchPublishMode')?.value || 'scheduled';

    if (selectedList.length === 0) {
      listContainer.innerHTML = '<div style="color:var(--text-dim);text-align:center;padding:10px;">ไม่มีคลิปที่เลือก</div>';
      if (summaryEl) summaryEl.textContent = '';
      return;
    }

    if (publishMode !== 'scheduled') {
      const modeText = publishMode === 'now' ? '⚡ โพสต์ทันทีทั้งหมด (เข้าคิวแบบทันที)'
        : (publishMode === 'draft' ? '📝 บันทึกร่างทั้งหมด (Save Draft)' : '🔒 โพสต์ส่วนตัวทั้งหมด (Private)');
      if (summaryEl) summaryEl.textContent = modeText;
      listContainer.innerHTML = selectedList.map((item, idx) => `
        <div style="display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:6px;background:var(--bg-card);">
          <span style="font-weight:700;color:var(--accent);">#${idx + 1}</span>
          <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.headline || item.productName || 'คลิป ' + (idx + 1)}</span>
          <span style="font-size:9px;color:var(--text-dim);">${modeText}</span>
        </div>
      `).join('');
      return;
    }

    const dateStr = $('#vBatchDate')?.value;
    const timeStr = $('#vBatchTime')?.value;
    if (!dateStr || !timeStr) {
      listContainer.innerHTML = '<div style="color:#ef4444;text-align:center;padding:10px;">กรุณาเลือกวันที่และเวลาเริ่ม</div>';
      if (summaryEl) summaryEl.textContent = '';
      return;
    }

    const intervalVal = parseInt($('#vBatchIntervalVal')?.value || '30', 10);
    const intervalUnit = $('#vBatchIntervalUnit')?.value || 'minutes';
    const intervalMinutes = intervalUnit === 'hours' ? intervalVal * 60 : intervalVal;
    const variationMinutes = parseInt($('#vBatchVariation')?.value || '0', 10);
    const baseMs = new Date(`${dateStr}T${timeStr}`).getTime();

    if (isNaN(baseMs)) {
      listContainer.innerHTML = '<div style="color:#ef4444;text-align:center;padding:10px;">รูปแบบวันที่/เวลาไม่ถูกต้อง</div>';
      return;
    }

    const nowMs = Date.now();
    let minTimeMs = Infinity;
    let maxTimeMs = -Infinity;

    const rowsHtml = selectedList.map((item, idx) => {
      const stepMs = idx * intervalMinutes * 60000;
      let variationMs = 0;
      if (variationMinutes > 0 && idx > 0) {
        const seed = (idx * 2654435761) >>> 0;
        const normalized = (seed % (2 * variationMinutes * 10 + 1)) / 10 - variationMinutes;
        variationMs = normalized * 60000;
      }
      const target = new Date(baseMs + stepMs + variationMs);
      target.setMinutes(Math.round(target.getMinutes() / 5) * 5);
      target.setSeconds(0, 0);

      // Warning if < 15 mins in future
      const isTooSoon = target.getTime() < (nowMs + 15 * 60000);

      if (target.getTime() < minTimeMs) minTimeMs = target.getTime();
      if (target.getTime() > maxTimeMs) maxTimeMs = target.getTime();

      const timeBadgeStyle = isTooSoon
        ? 'background:rgba(239,68,68,0.15);color:#ef4444;font-weight:700;'
        : 'background:rgba(34,197,94,0.15);color:#22c55e;font-weight:700;';
      const warningTag = isTooSoon ? ' ⚠️ (สั้นกว่า 15 นาที)' : '';

      return `
        <div style="display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:6px;background:var(--bg-card);">
          <span style="font-weight:700;color:var(--accent);">#${idx + 1}</span>
          <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${item.headline || item.productName || ''}">${item.headline || item.productName || 'คลิป ' + (idx + 1)}</span>
          <span style="padding:2px 6px;border-radius:4px;font-size:9px;white-space:nowrap;${timeBadgeStyle}">
            ${formatTimelineDate(target)}${warningTag}
          </span>
        </div>
      `;
    }).join('');

    listContainer.innerHTML = rowsHtml;

    if (summaryEl && minTimeMs !== Infinity && maxTimeMs !== -Infinity) {
      const minD = new Date(minTimeMs);
      const maxD = new Date(maxTimeMs);
      summaryEl.textContent = `${formatTimelineDate(minD)} - ${formatTimelineDate(maxD)}`;
    }
  }

  function openVaultBatchScheduleModal() {
    const selectedList = (currentVaultList || []).filter(v => selectedVaultIds.has(v.id));
    if (selectedList.length === 0) {
      showToast('⚠️ กรุณาเลือกคลิปอย่างน้อย 1 คลิปก่อนกดตั้งเวลา');
      return;
    }

    const modal = $('#vaultScheduleModal');
    if (!modal) return;

    // Update count display
    const countDisplay = $('#vBatchCountDisplay');
    const confirmCount = $('#vBatchConfirmCount');
    if (countDisplay) countDisplay.textContent = selectedList.length;
    if (confirmCount) confirmCount.textContent = selectedList.length;

    // Initialize default date & time (now + 25 mins rounded to 5 mins)
    const now = new Date();
    const start = new Date(now.getTime() + 25 * 60000);
    start.setMinutes(Math.ceil(start.getMinutes() / 5) * 5);
    start.setSeconds(0, 0);

    const yyyy = start.getFullYear();
    const mm = String(start.getMonth() + 1).padStart(2, '0');
    const dd = String(start.getDate()).padStart(2, '0');
    const hh = String(start.getHours()).padStart(2, '0');
    const min = String(start.getMinutes()).padStart(2, '0');

    if ($('#vBatchDate')) $('#vBatchDate').value = `${yyyy}-${mm}-${dd}`;
    if ($('#vBatchTime')) $('#vBatchTime').value = `${hh}:${min}`;

    // Publish mode visibility
    const modeSel = $('#vBatchPublishMode');
    const schedFields = $('#vBatchScheduleFields');
    if (modeSel && schedFields) {
      schedFields.style.display = modeSel.value === 'scheduled' ? 'block' : 'none';
    }

    renderBatchTimelinePreview();
    modal.classList.remove('hidden');
  }

  async function executeBatchSchedule() {
    const selectedList = (currentVaultList || []).filter(v => selectedVaultIds.has(v.id));
    if (selectedList.length === 0) {
      showToast('⚠️ กรุณาเลือกคลิปอย่างน้อย 1 คลิป');
      return;
    }

    const confirmBtn = $('#btnConfirmBatchSchedule');
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = '⏳ กำลังประมวลผล...';
    }

    const publishMode = $('#vBatchPublishMode')?.value || 'scheduled';
    const dateStr = $('#vBatchDate')?.value;
    const timeStr = $('#vBatchTime')?.value;
    const intervalVal = parseInt($('#vBatchIntervalVal')?.value || '30', 10);
    const intervalUnit = $('#vBatchIntervalUnit')?.value || 'minutes';
    const intervalMinutes = intervalUnit === 'hours' ? intervalVal * 60 : intervalVal;
    const variationMinutes = parseInt($('#vBatchVariation')?.value || '0', 10);
    const baseMs = (publishMode === 'scheduled' && dateStr && timeStr) ? new Date(`${dateStr}T${timeStr}`).getTime() : 0;

    let successCount = 0;
    let failCount = 0;

    for (let i = 0; i < selectedList.length; i++) {
      const item = selectedList[i];
      if (confirmBtn) confirmBtn.innerHTML = `⏳ บรรจุคลิป ${i + 1}/${selectedList.length}...`;

      try {
        const videoData = await loadVideoBase64(item);
        if (!videoData) {
          failCount++;
          continue;
        }

        const pHashtags = (Array.isArray(item.hashtags) && item.hashtags.length) ? item.hashtags : resolveProductHashtags(item);
        const prodTitle = (item.productName || item.headline || 'สินค้า').trim();
        const shortName = prodTitle.length > 55 ? prodTitle.slice(0, 52) + '...' : prodTitle;
        const tiktokHookVariations = [
          `🔥 ไอเทมเด็ดต้องมี! ${shortName} ดีไซน์สวย ใช้งานดีมาก พิกัดในตะกร้าเลยจ้า ✨`,
          `✨ ได้ลองแล้วเลิฟมาก! ${shortName} คุณภาพดีเกินราคา ป้ายยาในตะกร้าซ้ายล่างเลย 👇`,
          `💖 บอกต่อของดี! ${shortName} ตัวนี้ตอบโจทย์มาก คุ้มค่าเกินราคา รีบจัดก่อนหมดโปรนะ ⚡`,
          `💡 ใครเล็งตัวนี้อยู่แนะนำเลย! ${shortName} งานสวยตรงปก ใช้งานสะดวกมาก สั่งในตะกร้าได้เลย 👍`,
          `🎉 ป้ายยาแรงๆ เลยทุกคน ${shortName} ไอเทมยอดฮิต รีวิวแน่น ใช้งานดีจริงไม่มีผิดหวัง 🛒`,
          `⚡ ของมันต้องมีติดตัว! ${shortName} พกพาสะดวก คุณภาพคุ้มเกินราคา กดสั่งในตะกร้าเลย 💯`,
          `🌟 รีวิวจากใจ! ${shortName} ตัวจริงสวยตรงปกมาก คุ้มค่าคุ้มราคา การันตีความถูกใจจ้า 💖`,
          `🛒 ตัวนี้ปังมากทุกคน! ${shortName} ของดีบอกต่อ ใช้งานง่ายมาก พิกัดในตะกร้าเหลืองเลย 👇`
        ];
        const dynamicCaption = tiktokHookVariations[i % tiktokHookVariations.length];
        const pImg = item.productImage || resolveProductImage(item);
        const vThumb = item.thumbnail || await generateVideoThumbnail(videoData);

        let scheduledAt = null;
        if (publishMode === 'scheduled' && baseMs) {
          const targetMs = baseMs + (i * intervalMinutes * 60000);
          let variationMs = 0;
          if (variationMinutes > 0 && i > 0) {
            const seed = (i * 2654435761) >>> 0;
            const normalized = (seed % (2 * variationMinutes * 10 + 1)) / 10 - variationMinutes;
            variationMs = normalized * 60000;
          }
          const target = new Date(targetMs + variationMs);
          target.setMinutes(Math.round(target.getMinutes() / 5) * 5);
          target.setSeconds(0, 0);

          // TikTok Studio rule: at least 15 mins in future
          if (target.getTime() < Date.now() + 15 * 60000) {
            target.setTime(Date.now() + (16 + i * intervalMinutes) * 60000);
            target.setMinutes(Math.round(target.getMinutes() / 5) * 5);
          }
          scheduledAt = target.toISOString();
        }

        const catalogResolved = await resolveCatalogProduct(item, i);
        const tiktokJob = {
          id: `vault_batch_${Date.now()}_${i}_${Math.random().toString(36).slice(2, 6)}`,
          videoDataUrl: videoData,
          caption: dynamicCaption,
          hashtags: pHashtags,
          thumbnail: vThumb,
          productImage: catalogResolved.productImage || pImg,
          source: 'factory_vault',
          productId: catalogResolved.productId,
          publishMode: publishMode,
          scheduledAt: scheduledAt,
          status: 'pending',
          createdAt: new Date().toISOString(),
          needsAiCaption: true,
          aiContext: {
            productName: catalogResolved.productName || prodTitle,
            productDesc: item.headline || '',
            videoIndex: i,
            totalVideos: selectedList.length,
          }
        };

        const qRes = await sendMsg('PHIMBOT_ADD_TO_QUEUE', tiktokJob);
        if (qRes && qRes.success) {
          await sendMsg('PHIMBOT_VAULT_MARK_POSTED', { id: item.id, platform: 'tiktok' });
          successCount++;
        } else {
          failCount++;
        }
      } catch (err) {
        console.error('[VaultBatchSchedule] Error processing item:', item.id, err);
        failCount++;
      }
    }

    // Close modal
    $('#vaultScheduleModal')?.classList.add('hidden');
    if (confirmBtn) {
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = `🚀 ยืนยันบรรจุเข้าคิว (<span id="vBatchConfirmCount">${selectedList.length}</span> คลิป)`;
    }

    // Clear selection
    selectedVaultIds.clear();
    refreshVault();

    if (successCount > 0) {
      await sendMsg('PHIMBOT_START_QUEUE');
      showToast(`🎉 บรรจุเข้าคิว TikTok แล้ว ${successCount} คลิป และสั่งเริ่มโพสต์อัตโนมัติแล้ว!`);
    } else {
      showToast('❌ ไม่สามารถบรรจุคลิปเข้าคิวได้');
    }
  }

  function initVaultBatchControls() {
    // 1. Select All Toggle
    $('#vaultSelectAllToggle')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      const visibleCards = $$('#vaultGrid .vault-card');
      visibleCards.forEach(card => {
        const id = card.dataset.id;
        const chk = card.querySelector('.vault-item-chk');
        if (chk) chk.checked = checked;
        if (checked) {
          if (id) selectedVaultIds.add(id);
          card.classList.add('selected');
        } else {
          if (id) selectedVaultIds.delete(id);
          card.classList.remove('selected');
        }
      });
      updateVaultBatchBarUI();
    });

    // 2. Select Unposted Only
    $('#btnVaultSelectUnposted')?.addEventListener('click', () => {
      const unpostedItems = (currentVaultList || []).filter(v => !v.posted?.tiktok);
      selectedVaultIds.clear();
      unpostedItems.forEach(v => selectedVaultIds.add(v.id));

      const visibleCards = $$('#vaultGrid .vault-card');
      visibleCards.forEach(card => {
        const id = card.dataset.id;
        const isSelected = selectedVaultIds.has(id);
        const chk = card.querySelector('.vault-item-chk');
        if (chk) chk.checked = isSelected;
        card.classList.toggle('selected', isSelected);
      });
      updateVaultBatchBarUI();
      showToast(`เลือกคลิปที่ยังไม่โพสต์ TikTok ${unpostedItems.length} คลิป`);
    });

    // 3. Clear Selection
    $('#btnVaultClearSelect')?.addEventListener('click', () => {
      selectedVaultIds.clear();
      const visibleCards = $$('#vaultGrid .vault-card');
      visibleCards.forEach(card => {
        const chk = card.querySelector('.vault-item-chk');
        if (chk) chk.checked = false;
        card.classList.remove('selected');
      });
      updateVaultBatchBarUI();
    });

    // 4. Open Batch Schedule Modal
    $('#btnVaultBatchSchedule')?.addEventListener('click', openVaultBatchScheduleModal);

    // 5. Modal Close Buttons
    $('#btnCancelBatchSchedule')?.addEventListener('click', () => {
      $('#vaultScheduleModal')?.classList.add('hidden');
    });
    $('#btnCancelBatchScheduleX')?.addEventListener('click', () => {
      $('#vaultScheduleModal')?.classList.add('hidden');
    });

    // 6. Modal Inputs changes -> live timeline calculation
    $('#vBatchPublishMode')?.addEventListener('change', (e) => {
      const schedFields = $('#vBatchScheduleFields');
      if (schedFields) {
        schedFields.style.display = e.target.value === 'scheduled' ? 'block' : 'none';
      }
      renderBatchTimelinePreview();
    });

    ['#vBatchDate', '#vBatchTime', '#vBatchIntervalVal', '#vBatchIntervalUnit', '#vBatchVariation'].forEach(sel => {
      $(sel)?.addEventListener('input', renderBatchTimelinePreview);
      $(sel)?.addEventListener('change', renderBatchTimelinePreview);
    });

    // 7. Interval Quick Presets
    $$('.v-interval-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        $$('.v-interval-preset').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const val = btn.dataset.val;
        const unit = btn.dataset.unit;
        if ($('#vBatchIntervalVal')) $('#vBatchIntervalVal').value = val;
        if ($('#vBatchIntervalUnit')) $('#vBatchIntervalUnit').value = unit;
        renderBatchTimelinePreview();
      });
    });

    // 8. Confirm Batch Schedule
    $('#btnConfirmBatchSchedule')?.addEventListener('click', executeBatchSchedule);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     INIT
     ═══════════════════════════════════════════════════════════════════════ */
  // Initial render
  renderFactoryProducts();
  renderCharGrid();
  initVaultBatchControls();
  refreshVault();

  // Load saved factory settings
  (async () => {
    const [res, gStore] = await Promise.all([
      sendMsg('PHIMBOT_FACTORY_SETTINGS_GET'),
      chrome.storage.local.get(['phimbot_factory_voice_gender']).catch(() => ({})),
    ]);
    if (res.success && res.settings) {
      const s = res.settings;
      if ($('#factoryImageModel')) $('#factoryImageModel').value = (s.imageModel && s.imageModel.includes('Banana')) ? s.imageModel : '🍌 Nano Banana Pro';
      if ($('#factoryVideoModel')) $('#factoryVideoModel').value = s.videoModel || 'Veo 3.1 - Lite [Lower Priority]';
      if ($('#factoryDuration')) $('#factoryDuration').value = String(s.duration || 8);
      if ($('#factorySceneCount')) $('#factorySceneCount').value = String(s.sceneCount || 1);
      if ($('#factoryIdeaCount')) $('#factoryIdeaCount').value = String(s.ideaCount || 1);
      factoryMode = s.mode || 'influencer';
      const resolvedGender = gStore?.phimbot_factory_voice_gender || s.voiceGender || 'female';
      setFactoryGenderUI(resolvedGender, false, false);
    }
  })();

  // Auto-save settings on change
  ['#factoryImageModel', '#factoryVideoModel', '#factoryDuration', '#factorySceneCount', '#factoryIdeaCount'].forEach(sel => {
    $(sel)?.addEventListener('change', () => {
      sendMsg('PHIMBOT_FACTORY_SETTINGS_SAVE', {
        imageModel: $('#factoryImageModel')?.value,
        videoModel: $('#factoryVideoModel')?.value,
        duration: parseInt($('#factoryDuration')?.value || '8', 10),
        sceneCount: parseInt($('#factorySceneCount')?.value || '1', 10),
        ideaCount: parseInt($('#factoryIdeaCount')?.value || '1', 10),
        mode: factoryMode,
        voiceGender: factoryVoice
      });
    });
  });

  // ── Expose Antigravity Live Test API on window.__AG_FACTORY_API__ ──
  window.__AG_FACTORY_API__ = {
    getState: () => ({
      factoryProductsCount: factoryProducts.length,
      factoryProducts: factoryProducts.map(p => ({
        id: p.id,
        name: p.name,
        tiktokProductId: p.tiktokProductId,
        cleanPid: cleanProductId(p.tiktokProductId || p.id),
        imagesCount: Array.isArray(p.images) ? p.images.length : 0,
        productUrl: p.productUrl || '',
        platform: p.platform || '',
      })),
      charImagesCount: factoryCharImages.length,
      factoryMode,
      factoryVoice,
      isFactoryBusy,
      currentVaultCount: (currentVaultList || []).length,
    }),
    setFactoryProducts: (prods) => {
      factoryProducts = Array.isArray(prods) ? prods : [];
      window.__phimbotFactoryProducts = factoryProducts;
      renderFactoryProducts();
      return factoryProducts.length;
    },
    setCharImages: (imgs, voiceGender) => {
      factoryCharImages = Array.isArray(imgs) ? imgs : [];
      window.__phimbotFactoryCharImages = factoryCharImages;
      if (voiceGender === 'male' || voiceGender === 'female') {
        setFactoryGenderUI(voiceGender, true, true);
      }
      renderCharGrid();
      return { charImagesCount: factoryCharImages.length, factoryVoice };
    },
    setFactoryGenderUI,
    resolveCatalogProduct,
    cleanProductId,
    refreshVault,
    executeAutoPostTarget,
  };

})();
